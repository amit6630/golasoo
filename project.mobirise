                "flex-direction": "column",
                "justify-content": "space-between",
                "gap": "24px",
                "position": "fixed",
                "top": "70px",
                "right": "0",
                "left": "0",
                "height": "calc(100vh - 70px)",
                "overflow-y": "auto",
                "padding": "18px 22px 30px",
                "background": "#01184e",
                "background-image": "radial-gradient(600px 400px at 100% 0%, rgba(42, 168, 255, .25), transparent 70%)",
                "opacity": "0",
                "visibility": "hidden",
                "transform": "translateY(-12px)",
                "transition": "opacity .3s, transform .3s, visibility .3s"
              },
              ".go-toggle:checked ~ .go-panel": {
                "opacity": "1",
