d=\\\"M12 3v18a9 9 0 0 0 0-18Z\\\" class=\\\"fill\\\"/></svg><span>ניגודיות גבוהה</span></button><button type=\\\"button\\\" class=\\\"a11y__opt\\\" data-a11y=\\\"gray\\\" aria-pressed=\\\"false\\\"><svg viewBox=\\\"0 0 24 24\\\" aria-hidden=\\\"true\\\"><path d=\\\"M12 3s6 6.4 6 10.5a6 6 0 0 1-12 0C6 9.4 12 3 12 3Z\\\"/></svg><span>גווני אפור</span></button><button type=\\\"button\\\" class=\\\"a11y__opt\\\" data-a11y=\\\"links\\\" aria-pressed=\\\"false\\\"><svg viewBox=\\\"0 0 24 24\\\" aria-hidden=\\\"true\\\"><path d=\\\"M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1\\\"/></svg><span>הדגשת קישורים</span></button><button type=\\\"button\\\" class=\\\"a11y__opt\\\" data-a11y=\\\"headings\\\" aria-pressed=\\\"false\\\"><svg viewBox=\\\"0 0 24 24\\\" aria-hidden=\\\"true\\\"><path d=\\\"M5 5v14M13 5v14M5 12h8M17 9l2-1v11\\\"/></svg><span>הדגשת כותרות</span></button><button type=\\\"button\\\" class=\\\"a11y__opt\\\" data-a11y=\\\"font\\\" aria-pressed=\\\"false\\\"><svg viewBox=\\\"0 0 24 24\\\" aria-hidden=\\\"true\\\"><path d=\\\"M4 19 10 5l6 14M6.5 14h7M17 19h4\\\"/></svg><span>גופן קריא</span></button><button type=\\\"button\\\" class=\\\"a11y__opt\\\" data-a11y=\\\"spacing\\\" aria-pressed=\\\"false\\\"><svg viewBox=\\\"0 0 24 24\\\" aria-hidden=\\\"true\\\"><path d=\\\"M4 6h16M4 12h16M4 18h16\\\"/></svg><span>ריווח טקסט</span></button><button type=\\\"button\\\" class=\\\"a11y__opt\\\" data-a11y=\\\"motion\\\" aria-pressed=\\\"false\\\"><svg viewBox=\\\"0 0 24 24\\\" aria-hidden=\\\"true\\\"><rect x=\\\"6\\\" y=\\\"5\\\" width=\\\"4\\\" height=\\\"14\\\" rx=\\\"1\\\"/><rect x=\\\"14\\\" y=\\\"5\\\" width=\\\"4\\\" height=\\\"14\\\" rx=\\\"1\\\"/></svg><span>עצירת אנימציות</span></button><button type=\\\"button\\\" class=\\\"a11y__opt\\\" data-a11y=\\\"cursor\\\" aria-pressed=\\\"false\\\"><svg viewBox=\\\"0 0 24 24\\\" aria-hidden=\\\"true\\\"><path d=\\\"M5 3l14 7-6 2-2 6Z\\\"/></svg><span>סמן עכבר גדול</span></button></div><div class=\\\"a11y__foot\\\"><button type=\\\"button\\\" class=\\\"a11y__reset\\\" id=\\\"a11yReset\\\">איפוס הגדרות</button><a class=\\\"a11y__statement\\\" href=\\\"accessibility.html\\\">הצהרת נגישות</a></div></div>\";var sk=document.querySelector(\".go-skip\");if(sk)sk.parentNode.insertBefore(wrap,sk.nextSibling);else document.body.insertBefore(wrap,document.body.firstChild);\nvar toggle=document.getElementById(\"a11yToggle\"),panel=document.getElementById(\"a11yPanel\"),zo=wrap.querySelector('[data-a11y-zoom=\"-1\"]'),zi=wrap.querySelector('[data-a11y-zoom=\"1\"]'),zv=document.getElementById(\"a11yZoomValue\");\nfunction sync(){[].forEach.call(wrap.querySelectorAll(\"[data-a11y]\"),function(b){b.setAttribute(\"aria-pressed\",String(!!state[b.getAttribute(\"data-a11y\")]))});var i=state.zoom||0;zv.textContent=Math.round(Z[i]*100)+\"%\";zo.disabled=i===0;zi.disabled=i===Z.length-1}\nfunction open(v){panel.hidden=!v;toggle.setAttribute(\"aria-expanded\",String(v));if(v)panel.querySelector(\"button\").focus()}\ntoggle.addEventListener(\"click\",function(){open(panel.hidden)});document.getElementById(\"a11yClose\").addEventListener(\"click\",function(){open(false);toggle.focus()});\ndocument.addEventListener(\"keydown\",function(e){if(e.key===\"Escape\"&&!panel.hidden){open(false);toggle.focus()}});\ndocument.addEventListener(\"click\",function(e){if(!panel.hidden&&!wrap.contains(e.target))open(false)});\n[].forEach.call(wrap.querySelectorAll(\"[data-a11y-zoom]\"),function(b){b.addEventListener(\"click\",function(){state.zoom=Math.min(Z.length-1,Math.max(0,(state.zoom||0)+Number(b.getAttribute(\"data-a11y-zoom\"))));save(state);apply();sync()})});\n[].forEach.call(wrap.querySelectorAll(\"[data-a11y]\"),function(b){b.addEventListener(\"click\",function(){var k=b.getAttribute(\"data-a11y\");state[k]=!state[k];save(state);apply();sync();if(k===\"motion\")location.reload()})});\ndocument.getElementById(\"a11yReset\").addEventListener(\"click\",function(){var m=!!state.motion;state={};save(state);apply();sync();if(m)location.reload()});\napply();sync()}\nif(document.readyState===\"loading\")document.addEventListener(\"DOMContentLoaded\",init);else init()})();</script>",
