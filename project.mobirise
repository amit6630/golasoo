              "display": "flex",
              "align-items": "center",
              "gap": "10px",
              "flex": "none"
            },
            ".go-phone": {
              "display": "inline-flex",
              "align-items": "center",
              "gap": "9px",
              "color": "#ffffff !important",
              "text-decoration": "none !important",
              "font-weight": "500"
            },
            ".go-phone i": {
              "width": "42px",
              "height": "42px",
              "border-radius": "50%",
              "display": "inline-grid",
              "place-items": "center",
              "background": "rgba(111, 208, 255, .16)",
              "color": "#6fd0ff"
            },
            ".go-phone svg": {
              "width": "19px",
              "height": "19px"
            },
            ".go-cta": {
              "display": "inline-flex",
              "align-items": "center",
              "padding": "12px 22px",
              "border-radius": "999px",
              "color": "#01184e !important",
              "font-weight": "600",
              "text-decoration": "none !important",
              "background": "linear-gradient(120deg, #23dcfc, #6fd0ff)",
              "white-space": "nowrap",
              "transition": "transform .25s"
            },
            ".go-cta:hover": {
              "transform": "translateY(-2px)"
            },
            ".go-burger": {
              "display": "none",
              "width": "48px",
              "height": "48px",
              "border-radius": "50%",
              "margin": "0",
              "cursor": "pointer",
              "background": "rgba(111, 208, 255, .16)",
              "position": "relative"
            },
            ".go-burger span": {
              "position": "absolute",
              "right": "14px",
              "left": "14px",
              "height": "2px",
              "border-radius": "2px",
              "background": "#ffffff",
              "transition": "transform .3s, opacity .3s, top .3s"
            },
            ".go-burger span:nth-child(1)": {
              "top": "17px"
            },
            ".go-burger span:nth-child(2)": {
              "top": "23px"
            },
            ".go-burger span:nth-child(3)": {
              "top": "29px"
            },
            ".go-toggle:checked ~ .go-bar .go-burger span:nth-child(1)": {
              "top": "23px",
              "transform": "rotate(45deg)"
            },
            ".go-toggle:checked ~ .go-bar .go-burger span:nth-child(2)": {
              "opacity": "0"
            },
            ".go-toggle:checked ~ .go-bar .go-burger span:nth-child(3)": {
