        {
          "_name": "go-footer",
          "_sourceTheme": "gumm5",
          "_styles": {
            "direction": "rtl",
            "padding": "clamp(50px, 6vw, 76px) 0 0",
            "color": "#c9d8f0",
            "background-color": "#000f33",
            "background-image": "radial-gradient(700px 320px at 85% 0%, rgba(42, 168, 255, .2), transparent 70%)",
            ".go-fwrap": {
              "max-width": "1320px",
              "margin": "0 auto",
              "padding": "0 clamp(16px, 4vw, 48px)"
            },
            ".go-fcta": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "space-between",
              "gap": "24px",
              "padding": "0 0 38px",
              "margin-bottom": "40px",
              "border-bottom": "1px solid rgba(255, 255, 255, .12)"
            },
            ".go-fcta h2": {
              "margin": "0",
              "font-family": "'Karantina', sans-serif",
              "font-weight": "700",
