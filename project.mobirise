        {
          "_name": "go-hero",
          "_sourceTheme": "gumm5",
          "_styles": {
            "position": "relative",
            "overflow": "hidden",
            "direction": "rtl",
            "color": "#ffffff",
            "background-color": "#01184e",
            "background-size": "cover",
            "background-position": "center 40%",
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".go-shade": {
              "position": "absolute",
              "inset": "0",
              "background": "linear-gradient(270deg, rgba(1, 24, 78, .96) 0%, rgba(1, 24, 78, .86) 38%, rgba(1, 24, 78, .45) 70%, rgba(1, 24, 78, .25) 100%), linear-gradient(0deg, rgba(1, 15, 51, .9) 0%, transparent 45%)"
            },
            ".go-chalk": {
              "position": "absolute",
              "inset": "0",
              "width": "100%",
              "height": "100%",
              "pointer-events": "none"
            },
            ".go-chalk *": {
              "fill": "none",
              "stroke": "rgba(191, 233, 255, .34)",
              "stroke-width": "2"
            },
            ".go-wrap": {
              "position": "relative",
              "max-width": "1320px",
              "min-height": "min(80vh, 720px)",
              "margin": "0 auto",
              "padding": "0 clamp(16px, 4vw, 48px)",
              "display": "grid",
              "grid-template-columns": "1.25fr .75fr",
              "align-items": "center",
              "gap": "30px"
            },
            ".go-text": {
              "max-width": "640px"
            },
            ".go-kick": {
              "display": "inline-flex",
              "align-items": "center",
              "gap": "10px",
              "margin": "0 0 18px",
              "padding": "8px 16px 8px 8px",
              "border-radius": "999px",
              "background": "rgba(255, 255, 255, .1)",
              "border": "1px solid rgba(111, 208, 255, .35)",
              "font-size": ".95rem",
              "font-weight": "500",
              "color": "#dff4ff"
            },
            ".go-kick img": {
              "width": "30px",
              "height": "30px"
            },
            ".go-h1": {
              "margin": "0",
              "font-family": "'Karantina', sans-serif",
              "font-weight": "700",
              "font-size": "clamp(3.6rem, 9vw, 7.6rem)",
              "line-height": ".86",
              "letter-spacing": ".005em",
              "color": "#ffffff"
            },
            ".go-h1 span": {
              "display": "block",
              "color": "#23dcfc"
            },
            ".go-p": {
              "margin": "22px 0 0",
              "max-width": "34em",
              "font-size": "clamp(1.05rem, 1.5vw, 1.22rem)",
              "line-height": "1.7",
              "color": "#e3eeff"
            },
            ".go-chips": {
              "display": "flex",
              "flex-wrap": "wrap",
              "gap": "8px",
              "margin": "22px 0 0",
              "padding": "0",
              "list-style": "none"
            },
            ".go-chips li": {
              "padding": "7px 14px",
              "border-radius": "999px",
              "font-size": ".95rem",
              "font-weight": "500",
              "background": "rgba(1, 24, 78, .55)",
              "border": "1px solid rgba(255, 255, 255, .22)",
              "color": "#ffffff"
            },
            ".go-chips li::before": {
              "content": "'⚽'",
              "margin-left": "7px",
              "font-size": ".85em"
            },
            ".go-btns": {
              "display": "flex",
              "flex-wrap": "wrap",
              "gap": "12px",
              "margin-top": "30px"
            },
            ".go-art": {
              "position": "relative",
              "justify-self": "center",
              "width": "min(100%, 380px)",
              "aspect-ratio": "469 / 520"
            },
            ".go-art img": {
              "width": "100%",
              "height": "auto",
              "border-radius": "0",
              "filter": "drop-shadow(0 40px 60px rgba(0, 0, 0, .5))"
            },
            ".go-ring": {
              "position": "absolute",
              "inset": "-14%",
              "border-radius": "50%",
              "border": "2px dashed rgba(111, 208, 255, .35)"
            },
            ".go-scroll": {
              "position": "absolute",
              "bottom": "22px",
              "left": "50%",
              "width": "26px",
              "height": "42px",
              "margin-left": "-13px",
              "border": "2px solid rgba(255, 255, 255, .5)",
              "border-radius": "14px"
            },
            ".go-scroll::after": {
              "content": "''",
              "position": "absolute",
              "top": "8px",
              "left": "50%",
              "width": "4px",
              "height": "8px",
              "margin-left": "-2px",
              "border-radius": "2px",
              "background": "#23dcfc",
              "animation": "goWheel 1.8s ease-in-out infinite"
            },
            ".go-btn": {
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "gap": "10px",
              "min-height": "52px",
              "padding": "12px 26px",
              "border-radius": "999px",
              "font-weight": "600",
              "font-size": "1.05rem",
              "line-height": "1.2",
              "text-decoration": "none !important",
              "transition": "transform .3s cubic-bezier(.22,1,.36,1), box-shadow .3s, background .3s"
            },
            ".go-btn:hover": {
              "transform": "translateY(-2px)"
            },
            ".go-btn-main": {
              "color": "#01184e !important",
              "background": "linear-gradient(120deg, #23dcfc, #6fd0ff)",
              "box-shadow": "0 14px 30px -14px rgba(35, 220, 252, .9)"
            },
            ".go-btn-main:hover": {
              "box-shadow": "0 18px 36px -14px rgba(35, 220, 252, 1)"
            },
            ".go-btn-navy": {
              "color": "#ffffff !important",
              "background": "#01184e",
              "box-shadow": "0 14px 30px -16px rgba(1, 24, 78, .8)"
            },
            ".go-btn-navy:hover": {
              "background": "#0a2f7a"
            },
            ".go-btn-wa": {
              "color": "#ffffff !important",
              "background": "rgba(255, 255, 255, .1)",
              "border": "1.5px solid rgba(255, 255, 255, .55)"
            },
            ".go-btn-wa:hover": {
              "background": "rgba(255, 255, 255, .2)"
            },
            ".go-btn-line": {
              "color": "#01184e !important",
              "background": "transparent",
              "border": "1.5px solid rgba(1, 24, 78, .35)"
            },
            ".go-btn-line:hover": {
              "background": "rgba(1, 24, 78, .06)"
            },
            ".go-btn svg": {
              "width": "20px",
              "height": "20px",
              "flex": "none"
            },
            "@media (max-width: 991px)": {
              ".go-wrap": {
                "grid-template-columns": "1fr",
                "min-height": "0",
                "padding-top": "10px"
              },
              ".go-art": {
                "display": "none"
              },
              ".go-shade": {
                "background": "linear-gradient(0deg, rgba(1, 15, 51, .96) 0%, rgba(1, 24, 78, .82) 55%, rgba(1, 24, 78, .55) 100%)"
              },
              ".go-scroll": {
                "display": "none"
              }
            },
            "@media (max-width: 575px)": {
              ".go-btns .go-btn": {
                "flex": "1 1 100%"
              },
              ".go-chips li": {
                "font-size": ".88rem",
                "padding": "6px 12px"
              }
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"go-hero\" group=\"Custom\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"4\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n    <header>Background</header>\n    <fieldset type=\"background\" name=\"bg\">\n      <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/hero-team.webp\" selected>\n      <input type=\"color\" title=\"Color\" value=\"#ffffff\">\n    </fieldset>\n  </mbr-parameters>\n  <div class=\"go-shade\"></div>\n  <svg class=\"go-chalk\" viewBox=\"0 0 1440 800\" preserveAspectRatio=\"xMidYMid slice\" aria-hidden=\"true\"><line x1=\"380\" y1=\"-10\" x2=\"380\" y2=\"810\" pathLength=\"1\" style=\"--d:.3s\"/><circle cx=\"380\" cy=\"400\" r=\"190\" pathLength=\"1\" style=\"--d:.5s\"/><circle cx=\"380\" cy=\"400\" r=\"6\" pathLength=\"1\" style=\"--d:.9s\"/><rect x=\"-40\" y=\"190\" width=\"300\" height=\"420\" pathLength=\"1\" style=\"--d:.7s\"/><rect x=\"-40\" y=\"290\" width=\"140\" height=\"220\" pathLength=\"1\" style=\"--d:.9s\"/></svg>\n  <div class=\"go-wrap\">\n    <div class=\"go-text\">\n      <p class=\"go-kick\" data-go-reveal><img src=\"@PROJECT_PATH@/assets/images/logo-golazo-192.png\" alt=\"\" width=\"173\" height=\"192\"><span mbr-text>הפעלות ספורט ואימוני כדורגל · באר שבע</span></p>\n      <h1 class=\"go-h1\" data-go-reveal style=\"--d:.08s\" mbr-text>בית ספר לכדורגל<span>בבאר שבע</span></h1>\n      <p class=\"go-p\" data-go-reveal style=\"--d:.16s\" mbr-text>הילד חולם להיות כדורגלן? בגולאסו הוא ייהנה ממשחק שמשלב כיף ולמידה משמעותית: יחס אישי והעצמת הילד, משמעת וערכים, ולימוד יסודות וטכניקות משחק.</p>\n      <ul class=\"go-chips\" data-go-reveal style=\"--d:.22s\"><li mbr-text>בית ספר לכדורגל</li><li mbr-text>ימי הולדת כדורגל</li><li mbr-text>אימונים אישיים</li><li mbr-text>מחנה קיץ</li></ul>\n      <div class=\"go-btns\" data-go-reveal style=\"--d:.3s\">\n        <a class=\"go-btn go-btn-main\" href=\"#contact\" mbr-text>לפרטים והרשמה</a>\n        <a class=\"go-btn go-btn-wa\" href=\"https://wa.me/972547733821\" target=\"_blank\" rel=\"noopener\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"currentColor\"><path d=\"M12.04 2a9.9 9.9 0 0 0-8.5 15l-1.4 5 5.1-1.3A9.9 9.9 0 1 0 12.04 2Zm0 18.1a8.2 8.2 0 0 1-4.2-1.15l-.3-.18-3 .8.8-2.95-.2-.3a8.2 8.2 0 1 1 6.9 3.78Zm4.5-6.13c-.25-.12-1.46-.72-1.69-.8-.23-.08-.39-.12-.56.12-.16.25-.64.8-.78.97-.15.16-.29.18-.54.06a6.7 6.7 0 0 1-3.32-2.9c-.25-.43.25-.4.72-1.33.08-.16.04-.3-.02-.43l-.76-1.83c-.2-.48-.4-.41-.56-.42h-.47a.9.9 0 0 0-.66.31 2.76 2.76 0 0 0-.86 2.06 4.8 4.8 0 0 0 1 2.55 11 11 0 0 0 4.2 3.7c1.56.68 2.18.73 2.96.62.48-.07 1.46-.6 1.67-1.18.2-.58.2-1.07.15-1.18-.07-.1-.23-.16-.48-.29Z\"/></svg><span mbr-text>וואטסאפ למני</span></a>\n      </div>\n    </div>\n    <div class=\"go-art\" aria-hidden=\"true\">\n      <span class=\"go-ring go-spin\"></span>\n      <img class=\"go-float\" src=\"@PROJECT_PATH@/assets/images/logo-golazo.webp\" alt=\"\" width=\"469\" height=\"520\">\n    </div>\n  </div>\n  <span class=\"go-scroll\" aria-hidden=\"true\"></span>\n</section>",
          "_anchor": "top",
          "_cid": "w1U56npHMB",
          "_global": false,
          "_once": false,
          "_params": {},
          "_isUserblock": true,
          "_protectedParams": []
        },
        {
          "_name": "go-services",
          "_sourceTheme": "gumm5",
          "_styles": {
            "position": "relative",
            "direction": "rtl",
            "background-color": "#f3f6fb",
            "background-size": "cover",
            "background-position": "center",
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".go-kick": {
              "display": "inline-flex",
              "align-items": "center",
              "gap": "10px",
              "margin": "0 0 14px",
              "font-weight": "600",
              "font-size": ".95rem",
              "letter-spacing": ".02em",
              "color": "#0a58c9"
            },
            ".go-kick b": {
              "display": "inline-grid",
              "place-items": "center",
              "min-width": "38px",
              "height": "26px",
              "padding": "0 8px",
              "border-radius": "999px",
              "background": "#01184e",
              "color": "#ffffff",
              "font-family": "'Karantina', sans-serif",
              "font-size": "1.15rem",
              "font-weight": "700",
              "letter-spacing": ".04em"
            },
            ".go-title": {
              "margin": "0",
              "font-family": "'Karantina', sans-serif",
              "font-weight": "700",
              "font-size": "clamp(2.9rem, 6.2vw, 5rem)",
              "line-height": ".92",
              "color": "#01184e"
            },
            ".go-title span": {
              "display": "block",
              "color": "#0a58c9"
            },
            ".go-lead": {
              "margin": "16px 0 0",
              "max-width": "40em",
              "font-size": "clamp(1.02rem, 1.4vw, 1.15rem)",
              "line-height": "1.7",
              "color": "#3b4766"
            },
            ".go-wrap": {
              "max-width": "1320px",
              "margin": "0 auto",
              "padding": "0 clamp(16px, 4vw, 48px)"
            },
            ".go-top": {
              "display": "flex",
              "align-items": "flex-end",
              "justify-content": "space-between",
              "gap": "24px",
              "margin-bottom": "34px"
            },
            ".go-top .go-lead": {
              "max-width": "30em",
              "margin": "0"
            },
            ".go-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(6, 1fr)",
              "gap": "16px"
            },
            ".go-card": {
              "position": "relative",
              "grid-column": "span 2",
              "height": "250px",
              "border-radius": "26px",
              "overflow": "hidden",
              "display": "block",
              "color": "#ffffff !important",
              "text-decoration": "none !important",
              "background": "#01184e",
              "box-shadow": "0 24px 50px -32px rgba(1, 24, 78, .7)",
              "isolation": "isolate"
            },
            ".go-card.go-big": {
              "grid-column": "span 3",
              "height": "280px"
            },
            ".go-card img": {
              "position": "absolute",
              "inset": "0",
              "width": "100%",
              "height": "100%",
              "object-fit": "cover",
              "border-radius": "0",
              "z-index": "-2",
              "transition": "transform 1.1s cubic-bezier(.22,1,.36,1)"
            },
            ".go-card::after": {
              "content": "''",
              "position": "absolute",
              "inset": "0",
              "z-index": "-1",
              "background": "linear-gradient(0deg, rgba(1, 15, 51, .96) 0%, rgba(1, 24, 78, .7) 48%, rgba(1, 24, 78, .1) 100%)",
              "transition": "opacity .4s"
            },
            ".go-card:hover img": {
              "transform": "scale(1.07)"
            },
            ".go-card-body": {
              "position": "absolute",
              "inset": "auto 0 0 0",
              "padding": "22px 24px",
              "display": "grid",
              "gap": "6px"
            },
            ".go-card-n": {
              "font-family": "'Karantina', sans-serif",
              "font-size": "1.3rem",
              "font-weight": "700",
              "color": "#23dcfc",
              "line-height": "1"
            },
            ".go-card-t": {
              "font-family": "'Karantina', sans-serif",
              "font-size": "clamp(2rem, 3vw, 2.6rem)",
              "font-weight": "700",
              "line-height": ".95"
            },
            ".go-card-p": {
              "font-size": ".98rem",
              "line-height": "1.55",
              "color": "#e3eeff",
              "max-width": "34em"
            },
            ".go-card-go": {
              "display": "inline-flex",
              "align-items": "center",
              "gap": "8px",
              "margin-top": "6px",
              "font-weight": "600",
              "color": "#6fd0ff"
            },
            ".go-card-go svg": {
              "width": "20px",
              "height": "20px",
              "transition": "transform .3s"
            },
            ".go-card:hover .go-card-go svg": {
              "transform": "translateX(-5px)"
            },
            "@media (max-width: 991px)": {
              ".go-top": {
                "flex-direction": "column",
                "align-items": "flex-start"
              },
              ".go-grid": {
                "grid-template-columns": "1fr 1fr"
              },
              ".go-card, .go-card.go-big": {
                "grid-column": "span 1",
                "height": "280px"
              },
              ".go-card:first-child": {
                "grid-column": "1 / -1"
              }
            },
            "@media (max-width: 575px)": {
              ".go-grid": {
                "display": "flex",
                "overflow-x": "auto",
                "scroll-snap-type": "x mandatory",
                "gap": "12px",
                "margin": "0 -16px",
                "padding": "0 16px 6px",
                "scrollbar-width": "none"
              },
              ".go-card, .go-card.go-big, .go-card:first-child": {
                "flex": "0 0 84%",
                "height": "340px",
                "scroll-snap-align": "center"
              }
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"go-services\" group=\"Custom\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n    <header>Background</header>\n    <fieldset type=\"background\" name=\"bg\">\n      <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/texture-marble-light.webp\" selected>\n      <input type=\"color\" title=\"Color\" value=\"#ffffff\">\n    </fieldset>\n  </mbr-parameters>\n  <div class=\"go-wrap\">\n    <div class=\"go-top\">\n      <div data-go-reveal>\n        <p class=\"go-kick\"><b>01</b><span mbr-text>השירותים שלנו</span></p>\n        <h2 class=\"go-title\" mbr-text>כל מה שהילד שלכם צריך<span>במקום אחד</span></h2>\n      </div>\n      <p class=\"go-lead\" data-go-reveal style=\"--d:.1s\" mbr-text>אימונים, ימי הולדת, ימי גיבוש ומחנה קיץ, לבנים ולבנות. כל פעילות נבנית סביב הילד: הנאה, ביטחון עצמי ושיפור אמיתי במשחק.</p>\n    </div>\n    <div class=\"go-grid\"><a class=\"go-card go-big\" href=\"services.html#football-school\" data-go-reveal style=\"--d:0.00s\"><img src=\"@PROJECT_PATH@/assets/images/school-group.webp\" alt=\"ילדים בבית הספר לכדורגל של גולאסו\" width=\"1079\" height=\"662\" loading=\"lazy\"><span class=\"go-card-body\"><span class=\"go-card-n\">01</span><span class=\"go-card-t\" mbr-text>בית הספר לכדורגל</span><span class=\"go-card-p\" mbr-text>לכיתות א'-ו': לימוד יסודות המשחק, ציוד חדיש ומשחקים מול קבוצות מתחרות. עונה גדושה בהצלחות.</span><span class=\"go-card-go\"><span mbr-text>לפרטים והרשמה</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M19 12H5M11 6l-6 6 6 6\"/></svg></span></span></a><a class=\"go-card go-big\" href=\"services.html#birthday\" data-go-reveal style=\"--d:0.07s\"><img src=\"@PROJECT_PATH@/assets/images/birthday-group.webp\" alt=\"ילדים חוגגים יום הולדת כדורגל בגולאסו\" width=\"1200\" height=\"1200\" loading=\"lazy\"><span class=\"go-card-body\"><span class=\"go-card-n\">02</span><span class=\"go-card-t\" mbr-text>ימי הולדת כדורגל</span><span class=\"go-card-p\" mbr-text>חוויה של ספורט, אנרגיה והנאה לילד ולכל החברים: מאמן מקצועי, מוזיקה, גביע לחוגג ומדליות לכולם.</span><span class=\"go-card-go\"><span mbr-text>שריינו תאריך</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M19 12H5M11 6l-6 6 6 6\"/></svg></span></span></a><a class=\"go-card \" href=\"services.html#private-training\" data-go-reveal style=\"--d:0.14s\"><img src=\"@PROJECT_PATH@/assets/images/private-shot.webp\" alt=\"אימון כדורגל אישי עם מאמן\" width=\"1400\" height=\"933\" loading=\"lazy\"><span class=\"go-card-body\"><span class=\"go-card-n\">03</span><span class=\"go-card-t\" mbr-text>אימונים אישיים</span><span class=\"go-card-p\" mbr-text>אימון מנטלי ומקצועי: קואורדינציה, שליטה בכדור וליווי צמוד לאורך כל הדרך.</span><span class=\"go-card-go\"><span mbr-text>לתיאום אימון</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M19 12H5M11 6l-6 6 6 6\"/></svg></span></span></a><a class=\"go-card \" href=\"services.html#team-days\" data-go-reveal style=\"--d:0.21s\"><img src=\"@PROJECT_PATH@/assets/images/teamday-dart.webp\" alt=\"ילדים במשחק דארט כדורגל ביום גיבוש\" width=\"1080\" height=\"774\" loading=\"lazy\"><span class=\"go-card-body\"><span class=\"go-card-n\">04</span><span class=\"go-card-t\" mbr-text>ימי גיבוש והפעלות</span><span class=\"go-card-p\" mbr-text>משחקי צוות ותחרויות שמגבשים את הקבוצה, עם ציוד ייחודי. מתאים גם למסיבות סיום.</span><span class=\"go-card-go\"><span mbr-text>לפרטים</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M19 12H5M11 6l-6 6 6 6\"/></svg></span></span></a><a class=\"go-card \" href=\"services.html#summer-camp\" data-go-reveal style=\"--d:0.28s\"><img src=\"@PROJECT_PATH@/assets/images/camp-goal.webp\" alt=\"קבוצת ילדים במחנה הקיץ של גולאסו\" width=\"820\" height=\"1093\" loading=\"lazy\"><span class=\"go-card-body\"><span class=\"go-card-n\">05</span><span class=\"go-card-t\" mbr-text>מחנה קיץ</span><span class=\"go-card-p\" mbr-text>אימונים איכותיים וכיף בלי הפסקה, כל הקיץ על המגרש.</span><span class=\"go-card-go\"><span mbr-text>לפרטים על המחנה</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M19 12H5M11 6l-6 6 6 6\"/></svg></span></span></a></div>\n  </div>\n</section>",
          "_anchor": "services",
          "_cid": "wIcsNAyFZz",
          "_global": false,
          "_once": false,
          "_params": {},
          "_isUserblock": true,
          "_protectedParams": []
        },
        {
          "_name": "go-why",
          "_sourceTheme": "gumm5",
          "_styles": {
            "position": "relative",
            "overflow": "hidden",
            "direction": "rtl",
            "color": "#ffffff",
            "background-color": "#01184e",
            "background-size": "cover",
            "background-position": "center",
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".go-kick": {
              "display": "inline-flex",
              "align-items": "center",
              "gap": "10px",
              "margin": "0 0 14px",
              "font-weight": "600",
              "font-size": ".95rem",
              "letter-spacing": ".02em",
              "color": "#6fd0ff"
            },
            ".go-kick b": {
              "display": "inline-grid",
              "place-items": "center",
              "min-width": "38px",
              "height": "26px",
              "padding": "0 8px",
              "border-radius": "999px",
              "background": "#23dcfc",
              "color": "#01184e",
              "font-family": "'Karantina', sans-serif",
              "font-size": "1.15rem",
              "font-weight": "700",
              "letter-spacing": ".04em"
            },
            ".go-title": {
              "margin": "0",
              "font-family": "'Karantina', sans-serif",
              "font-weight": "700",
              "font-size": "clamp(2.9rem, 6.2vw, 5rem)",
              "line-height": ".92",
              "color": "#ffffff"
            },
            ".go-title span": {
              "display": "block",
              "color": "#23dcfc"
            },
            ".go-lead": {
              "margin": "16px 0 0",
              "max-width": "40em",
              "font-size": "clamp(1.02rem, 1.4vw, 1.15rem)",
              "line-height": "1.7",
              "color": "#d3e3fb"
            },
            ".go-pitch": {
              "position": "absolute",
              "top": "50%",
              "left": "-120px",
              "width": "520px",
              "height": "520px",
              "margin-top": "-260px",
              "border-radius": "50%",
              "border": "2px solid rgba(111, 208, 255, .14)",
              "pointer-events": "none"
            },
            ".go-pitch::after": {
              "content": "''",
              "position": "absolute",
              "top": "-400px",
              "bottom": "-400px",
              "left": "50%",
              "border-left": "2px solid rgba(111, 208, 255, .14)"
            },
            ".go-wrap": {
              "position": "relative",
              "max-width": "1320px",
              "margin": "0 auto",
              "padding": "0 clamp(16px, 4vw, 48px)",
              "display": "grid",
              "grid-template-columns": ".8fr 1.2fr",
              "gap": "clamp(28px, 5vw, 70px)",
              "align-items": "center"
            },
            ".go-photo": {
              "position": "relative",
              "margin-top": "28px",
              "border-radius": "26px",
              "overflow": "hidden",
              "aspect-ratio": "16 / 10",
              "box-shadow": "0 30px 60px -30px rgba(0, 0, 0, .8)"
            },
            ".go-photo img": {
              "width": "100%",
              "height": "100%",
              "object-fit": "cover",
              "border-radius": "0"
            },
            ".go-list": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr",
              "gap": "14px",
              "margin": "0",
              "padding": "0",
              "list-style": "none"
            },
            ".go-item": {
              "position": "relative",
              "padding": "22px 22px 20px",
              "border-radius": "22px",
              "background": "rgba(255, 255, 255, .06)",
              "border": "1px solid rgba(111, 208, 255, .2)",
              "-webkit-backdrop-filter": "blur(6px)",
              "backdrop-filter": "blur(6px)",
              "transition": "background .35s, transform .35s cubic-bezier(.22,1,.36,1)"
            },
            ".go-item:hover": {
              "background": "rgba(255, 255, 255, .11)",
              "transform": "translateY(-4px)"
            },
            ".go-num": {
              "display": "block",
              "font-family": "'Karantina', sans-serif",
              "font-weight": "700",
              "font-size": "3rem",
              "line-height": ".8",
              "color": "transparent",
              "-webkit-text-stroke": "1.5px #23dcfc",
              "margin-bottom": "10px"
            },
            ".go-item h3": {
              "margin": "0 0 6px",
              "font-family": "'Karantina', sans-serif",
              "font-weight": "700",
              "font-size": "1.9rem",
              "line-height": "1",
              "color": "#ffffff"
            },
            ".go-item p": {
              "margin": "0",
              "font-size": ".98rem",
              "line-height": "1.6",
              "color": "#d3e3fb"
            },
            "@media (max-width: 991px)": {
              ".go-wrap": {
                "grid-template-columns": "1fr"
              },
              ".go-photo": {
                "display": "none"
              }
            },
            "@media (max-width: 575px)": {
              ".go-list": {
                "grid-template-columns": "1fr 1fr",
                "gap": "10px"
              },
              ".go-item": {
                "padding": "16px 14px"
              },
              ".go-num": {
                "font-size": "2.3rem"
              },
              ".go-item h3": {
                "font-size": "1.5rem"
              },
              ".go-item p": {
                "font-size": ".9rem"
              }
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"go-why go-dark\" group=\"Custom\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"6\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"6\">\n    <header>Background</header>\n    <fieldset type=\"background\" name=\"bg\">\n      <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/texture-marble-navy.webp\" selected>\n      <input type=\"color\" title=\"Color\" value=\"#ffffff\">\n    </fieldset>\n  </mbr-parameters>\n  <span class=\"go-pitch\" aria-hidden=\"true\"></span>\n  <div class=\"go-wrap\">\n    <div data-go-reveal>\n      <p class=\"go-kick\"><b>02</b><span mbr-text>למה אצלנו?</span></p>\n      <h2 class=\"go-title\" mbr-text>הילד שלך<span>המשימה שלנו</span></h2>\n      <p class=\"go-lead\" mbr-text>אנחנו מאמינים שהאדם בא לפני השחקן. לכן כל אימון בגולאסו משלב כדורגל טוב עם ערכים, משמעת וביטחון עצמי.</p>\n      <div class=\"go-photo\"><img src=\"@PROJECT_PATH@/assets/images/school-line.webp\" alt=\"מאמן גולאסו מדריך ילדים בתרגיל כדרור\" width=\"522\" height=\"390\" loading=\"lazy\"></div>\n    </div>\n    <ul class=\"go-list\"><li class=\"go-item\" data-go-reveal style=\"--d:0.00s\"><span class=\"go-num\" aria-hidden=\"true\">01</span><h3 mbr-text>יחס אישי ומקצועי</h3><p mbr-text>הילד במרכז, עם ירידה לפרטים הקטנים במגוון אימונים.</p></li><li class=\"go-item\" data-go-reveal style=\"--d:0.06s\"><span class=\"go-num\" aria-hidden=\"true\">02</span><h3 mbr-text>העצמת השחקן</h3><p mbr-text>חיזוק הביטחון העצמי בפן האישי והקבוצתי לאורך כל הדרך.</p></li><li class=\"go-item\" data-go-reveal style=\"--d:0.12s\"><span class=\"go-num\" aria-hidden=\"true\">03</span><h3 mbr-text>פעילות ספורטיבית מגוונת</h3><p mbr-text>ימי הולדת כדורגל ואירועי ספורט מגוונים לבנים ולבנות.</p></li><li class=\"go-item\" data-go-reveal style=\"--d:0.18s\"><span class=\"go-num\" aria-hidden=\"true\">04</span><h3 mbr-text>ציוד חדש וייחודי</h3><p mbr-text>ציוד מקצועי וחדשני שמותאם לכל פעילות.</p></li><li class=\"go-item\" data-go-reveal style=\"--d:0.24s\"><span class=\"go-num\" aria-hidden=\"true\">05</span><h3 mbr-text>חינוך לערכים ומשמעת</h3><p mbr-text>האדם בא לפני השחקן: חינוך למצוינות ולערכים.</p></li><li class=\"go-item\" data-go-reveal style=\"--d:0.30s\"><span class=\"go-num\" aria-hidden=\"true\">06</span><h3 mbr-text>הילד שלך, המשימה שלנו</h3><p mbr-text>ההצלחה וההנאה של הילד הן המדד המרכזי להצלחה שלנו.</p></li></ul>\n  </div>\n</section>",
          "_anchor": "why",
          "_cid": "wbjtLkbXdG",
          "_global": false,
          "_once": false,
          "_params": {},
          "_isUserblock": true,
          "_protectedParams": []
        },
        {
          "_name": "go-reviews",
          "_sourceTheme": "gumm5",
          "_styles": {
            "position": "relative",
            "direction": "rtl",
            "background-color": "#ffffff",
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            ".go-kick": {
              "display": "inline-flex",
              "align-items": "center",
              "gap": "10px",
              "margin": "0 0 14px",
              "font-weight": "600",
              "font-size": ".95rem",
              "letter-spacing": ".02em",
              "color": "#0a58c9"
            },
            ".go-kick b": {
              "display": "inline-grid",
              "place-items": "center",
              "min-width": "38px",
              "height": "26px",
              "padding": "0 8px",
              "border-radius": "999px",
              "background": "#01184e",
              "color": "#ffffff",
              "font-family": "'Karantina', sans-serif",
              "font-size": "1.15rem",
              "font-weight": "700",
              "letter-spacing": ".04em"
            },
            ".go-title": {
              "margin": "0",
              "font-family": "'Karantina', sans-serif",
              "font-weight": "700",
              "font-size": "clamp(2.9rem, 6.2vw, 5rem)",
              "line-height": ".92",
              "color": "#01184e"
            },
            ".go-title span": {
              "display": "block",
              "color": "#0a58c9"
            },
            ".go-lead": {
              "margin": "16px 0 0",
              "max-width": "40em",
              "font-size": "clamp(1.02rem, 1.4vw, 1.15rem)",
              "line-height": "1.7",
              "color": "#3b4766"
            },
            ".go-wrap": {
              "max-width": "1320px",
              "margin": "0 auto",
              "padding": "0 clamp(16px, 4vw, 48px)"
            },
            ".go-top": {
              "text-align": "center",
              "margin": "0 auto 34px",
              "max-width": "760px"
            },
            ".go-top .go-lead": {
              "margin-left": "auto",
              "margin-right": "auto"
            },
            ".go-grid": {
              "display": "grid",
              "grid-template-columns": "repeat(4, 1fr)",
              "gap": "16px",
              "margin": "0",
              "padding": "0",
              "list-style": "none"
            },
            ".go-rev": {
              "position": "relative",
              "display": "flex",
              "flex-direction": "column",
              "padding": "26px 24px 22px",
              "border-radius": "26px",
              "background": "#f3f6fb",
              "border": "1px solid #e1e9f5"
            },
            ".go-rev:nth-child(even)": {
              "background": "#01184e",
              "border-color": "#01184e"
            },
            ".go-rev:nth-child(even) blockquote, .go-rev:nth-child(even) .go-who b": {
              "color": "#ffffff"
            },
            ".go-rev:nth-child(even) .go-who span": {
              "color": "#b9d2f5"
            },
            ".go-q": {
              "font-family": "'Karantina', sans-serif",
              "font-size": "5rem",
              "line-height": ".5",
              "height": "34px",
              "color": "#23dcfc"
            },
            ".go-stars": {
              "color": "#f5a400",
              "letter-spacing": "3px",
              "font-size": "1.05rem",
              "margin": "0 0 10px"
            },
            ".go-rev blockquote": {
              "margin": "0 0 18px",
              "padding": "0",
              "border": "0",
              "font-size": "1.02rem",
              "line-height": "1.7",
              "color": "#24304a",
              "flex": "1"
            },
            ".go-who": {
              "display": "grid",
              "gap": "2px",
              "padding-top": "14px",
              "border-top": "1px solid rgba(10, 88, 201, .18)"
            },
            ".go-who b": {
              "font-weight": "600",
              "color": "#01184e"
            },
            ".go-who span": {
              "font-size": ".93rem",
              "color": "#4a5672"
            },
            "@media (max-width: 1100px)": {
              ".go-grid": {
                "grid-template-columns": "1fr 1fr"
              }
            },
            "@media (max-width: 575px)": {
              ".go-grid": {
                "display": "flex",
                "overflow-x": "auto",
                "scroll-snap-type": "x mandatory",
                "gap": "12px",
                "margin": "0 -16px",
                "padding": "0 16px 6px",
                "scrollbar-width": "none"
              },
              ".go-rev": {
                "flex": "0 0 84%",
                "scroll-snap-align": "center"
              }
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"go-reviews\" group=\"Custom\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"6\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"6\">\n  </mbr-parameters>\n  <div class=\"go-wrap\">\n    <div class=\"go-top\" data-go-reveal>\n      <p class=\"go-kick\"><b>03</b><span mbr-text>הורים ממליצים</span></p>\n      <h2 class=\"go-title\" mbr-text>מה ההורים<span>אומרים עלינו?</span></h2>\n      <p class=\"go-lead\" mbr-text>ההצלחה של הילד שלכם היא הגאווה הגדולה ביותר שלנו.</p>\n    </div>\n    <ul class=\"go-grid\" tabindex=\"0\" aria-label=\"המלצות של הורים\"><li class=\"go-rev\" data-go-reveal style=\"--d:0.00s\"><span class=\"go-q\" aria-hidden=\"true\">”</span><p class=\"go-stars\" role=\"img\" aria-label=\"5 כוכבים מתוך 5\">★★★★★</p><blockquote mbr-text>הילד לא מפסיק לחכות לאימונים! היחס האישי של המאמנים והעצמת הביטחון העצמי שלו פשוט מדהימים. גולאסו זה הרבה מעבר לכדורגל.</blockquote><p class=\"go-who\"><b mbr-text>מירי לוי</b><span mbr-text>אמא של עומר</span></p></li><li class=\"go-rev\" data-go-reveal style=\"--d:0.07s\"><span class=\"go-q\" aria-hidden=\"true\">”</span><p class=\"go-stars\" role=\"img\" aria-label=\"5 כוכבים מתוך 5\">★★★★★</p><blockquote mbr-text>יום ההולדת כדורגל שעשיתם לנו היה פשוט מושלם! הילדים היו בעננים, הציוד היה חדש והכל תקתק. מומלץ בחום לכל הורה!</blockquote><p class=\"go-who\"><b mbr-text>דוד כהן</b><span mbr-text>אבא של איתי</span></p></li><li class=\"go-rev\" data-go-reveal style=\"--d:0.14s\"><span class=\"go-q\" aria-hidden=\"true\">”</span><p class=\"go-stars\" role=\"img\" aria-label=\"5 כוכבים מתוך 5\">★★★★★</p><blockquote mbr-text>השיפור הטכני של בני פשוט מדהים. האימונים האישיים ממוקדים מאוד והאווירה בבית הספר מעודדת מצוינות וערכים.</blockquote><p class=\"go-who\"><b mbr-text>יובל רז</b><span mbr-text>אבא של נועם</span></p></li><li class=\"go-rev\" data-go-reveal style=\"--d:0.21s\"><span class=\"go-q\" aria-hidden=\"true\">”</span><p class=\"go-stars\" role=\"img\" aria-label=\"5 כוכבים מתוך 5\">★★★★★</p><blockquote mbr-text>תודה רבה על מחנה קיץ בלתי נשכח! הילד חזר מאושר עם חברים חדשים ושיפור אדיר במשחק. מחכים כבר לשנה הבאה!</blockquote><p class=\"go-who\"><b mbr-text>רונית אברהם</b><span mbr-text>אמא של שגיא</span></p></li></ul>\n  </div>\n</section>",
          "_anchor": "reviews",
          "_cid": "wppOBi92pt",
          "_global": false,
          "_once": false,
          "_params": {},
          "_isUserblock": true,
          "_protectedParams": []
        },
        {
          "_name": "go-gallery",
          "_sourceTheme": "gumm5",
          "_styles": {
            "position": "relative",
            "overflow": "hidden",
            "direction": "rtl",
            "color": "#ffffff",
            "background-color": "#000f33",
            "background-image": "radial-gradient(900px 500px at 90% 0%, rgba(42, 168, 255, .22), transparent 70%)",
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            ".go-kick": {
              "display": "inline-flex",
              "align-items": "center",
              "gap": "10px",
              "margin": "0 0 14px",
              "font-weight": "600",
              "font-size": ".95rem",
              "letter-spacing": ".02em",
              "color": "#6fd0ff"
            },
            ".go-kick b": {
              "display": "inline-grid",
              "place-items": "center",
              "min-width": "38px",
              "height": "26px",
              "padding": "0 8px",
              "border-radius": "999px",
              "background": "#23dcfc",
              "color": "#01184e",
              "font-family": "'Karantina', sans-serif",
              "font-size": "1.15rem",
              "font-weight": "700",
              "letter-spacing": ".04em"
            },
            ".go-title": {
              "margin": "0",
              "font-family": "'Karantina', sans-serif",
              "font-weight": "700",
              "font-size": "clamp(2.9rem, 6.2vw, 5rem)",
              "line-height": ".92",
              "color": "#ffffff"
            },
            ".go-title span": {
              "display": "block",
              "color": "#23dcfc"
            },
            ".go-lead": {
              "margin": "16px 0 0",
              "max-width": "40em",
              "font-size": "clamp(1.02rem, 1.4vw, 1.15rem)",
              "line-height": "1.7",
              "color": "#3b4766"
            },
            ".go-wrap": {
              "max-width": "1320px",
              "margin": "0 auto",
              "padding": "0 clamp(16px, 4vw, 48px)"
            },
            ".go-top": {
              "display": "flex",
              "align-items": "flex-end",
              "justify-content": "space-between",
              "gap": "20px",
              "margin-bottom": "26px"
            },
            ".go-arrows": {
              "display": "flex",
              "gap": "10px"
            },
            ".go-arrows button": {
              "width": "52px",
              "height": "52px",
              "border-radius": "50%",
              "border": "1.5px solid rgba(255, 255, 255, .4)",
              "background": "transparent",
              "color": "#ffffff",
              "display": "grid",
              "place-items": "center",
              "cursor": "pointer",
              "transition": "background .25s"
            },
            ".go-arrows button:hover": {
              "background": "rgba(255, 255, 255, .12)"
            },
            ".go-arrows svg": {
              "width": "22px",
              "height": "22px"
            },
            ".go-arrows button:last-child svg": {
              "transform": "scaleX(-1)"
            },
            ".go-rail": {
              "display": "flex",
              "gap": "14px",
              "overflow-x": "auto",
              "scroll-snap-type": "x mandatory",
              "scrollbar-width": "none",
              "padding": "4px clamp(16px, 4vw, 48px) 10px",
              "margin": "0",
              "list-style": "none"
            },
            ".go-rail::-webkit-scrollbar": {
              "display": "none"
            },
            ".go-shot": {
              "flex": "none",
              "height": "clamp(260px, 38vw, 420px)",
              "margin": "0",
              "border-radius": "24px",
              "overflow": "hidden",
              "scroll-snap-align": "start",
              "background": "#01184e"
            },
            ".go-shot img": {
              "height": "100%",
              "width": "auto",
              "max-width": "none",
              "display": "block",
              "border-radius": "0",
              "transition": "transform 1s cubic-bezier(.22,1,.36,1)"
            },
            ".go-shot:hover img": {
              "transform": "scale(1.05)"
            },
            ".go-follow": {
              "display": "flex",
              "flex-wrap": "wrap",
              "gap": "10px",
              "margin-top": "22px"
            },
            ".go-follow a": {
              "display": "inline-flex",
              "align-items": "center",
              "gap": "8px",
              "padding": "10px 18px",
              "border-radius": "999px",
              "border": "1.5px solid rgba(255, 255, 255, .35)",
              "color": "#ffffff !important",
              "text-decoration": "none !important",
              "font-weight": "500"
            },
            ".go-follow a:hover": {
              "background": "rgba(255, 255, 255, .1)"
            },
            "@media (max-width: 575px)": {
              ".go-arrows": {
                "display": "none"
              },
              ".go-shot": {
                "height": "300px"
              }
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"go-gallery go-dark\" group=\"Custom\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"6\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"6\">\n  </mbr-parameters>\n  <div data-go-rail>\n    <div class=\"go-wrap\">\n      <div class=\"go-top\" data-go-reveal>\n        <div>\n          <p class=\"go-kick\"><b>04</b><span mbr-text>תמונות מאירועים</span></p>\n          <h2 class=\"go-title\" mbr-text>רגעים<span>מהמגרש</span></h2>\n        </div>\n        <div class=\"go-arrows\"><button type=\"button\" data-go-step=\"1\" aria-label=\"תמונות קודמות\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M19 12H5M11 6l-6 6 6 6\"/></svg></button><button type=\"button\" data-go-step=\"-1\" aria-label=\"תמונות הבאות\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M19 12H5M11 6l-6 6 6 6\"/></svg></button></div>\n      </div>\n    </div>\n    <ul class=\"go-rail\" tabindex=\"0\" aria-label=\"גלריית תמונות\"><li class=\"go-shot\"><img src=\"@PROJECT_PATH@/assets/images/hero-team.webp\" alt=\"קבוצת ילדים של גולאסו על המגרש בשקיעה\" width=\"1600\" height=\"1200\" loading=\"lazy\"></li><li class=\"go-shot\"><img src=\"@PROJECT_PATH@/assets/images/private-kick.webp\" alt=\"ילד בועט בכדור לרשת אימון\" width=\"1024\" height=\"683\" loading=\"lazy\"></li><li class=\"go-shot\"><img src=\"@PROJECT_PATH@/assets/images/birthday-kids.webp\" alt=\"ילדים בתרגיל זריזות עם סולם אימון ביום הולדת\" width=\"820\" height=\"1093\" loading=\"lazy\"></li><li class=\"go-shot\"><img src=\"@PROJECT_PATH@/assets/images/school-red-team.webp\" alt=\"ילדים בחולצות אדומות בתמונה קבוצתית\" width=\"1600\" height=\"747\" loading=\"lazy\"></li><li class=\"go-shot\"><img src=\"@PROJECT_PATH@/assets/images/teamday-race.webp\" alt=\"מרוץ שקים ביום גיבוש\" width=\"820\" height=\"1093\" loading=\"lazy\"></li><li class=\"go-shot\"><img src=\"@PROJECT_PATH@/assets/images/private-dribble.webp\" alt=\"ילד מתאמן בכדרור עם מאמן\" width=\"1024\" height=\"683\" loading=\"lazy\"></li><li class=\"go-shot\"><img src=\"@PROJECT_PATH@/assets/images/school-sitting.webp\" alt=\"עשרות ילדים יושבים על הדשא לפני אימון\" width=\"1079\" height=\"667\" loading=\"lazy\"></li><li class=\"go-shot\"><img src=\"@PROJECT_PATH@/assets/images/teamday-balloon.webp\" alt=\"משחק עם כדור ענק ביום הפעלות\" width=\"820\" height=\"1093\" loading=\"lazy\"></li><li class=\"go-shot\"><img src=\"@PROJECT_PATH@/assets/images/school-drill.webp\" alt=\"תרגיל עם קונוסים על המגרש\" width=\"1400\" height=\"1050\" loading=\"lazy\"></li><li class=\"go-shot\"><img src=\"@PROJECT_PATH@/assets/images/private-tall.webp\" alt=\"ילד מתאמן לבד על מגרש הדשא\" width=\"820\" height=\"1458\" loading=\"lazy\"></li></ul>\n    <div class=\"go-wrap\"><div class=\"go-follow\"><a href=\"https://www.instagram.com/golasso_b7/\" target=\"_blank\" rel=\"noopener\"><span class=\"socicon socicon-instagram mbr-iconfont\" aria-hidden=\"true\"></span><span mbr-text>עוד באינסטגרם</span></a><a href=\"https://www.facebook.com/p/%D7%92%D7%95%D7%9C%D7%90%D7%A1%D7%95-%D7%94%D7%A4%D7%A2%D7%9C%D7%95%D7%AA-%D7%A1%D7%A4%D7%95%D7%A8%D7%98-%D7%95%D7%90%D7%99%D7%9E%D7%95%D7%A0%D7%99-%D7%9B%D7%93%D7%95%D7%A8%D7%92%D7%9C-100063978907753/\" target=\"_blank\" rel=\"noopener\"><span class=\"socicon socicon-facebook mbr-iconfont\" aria-hidden=\"true\"></span><span mbr-text>עוד בפייסבוק</span></a></div></div>\n  </div>\n</section>",
