          "_customHTML": "<section data-bs-version=\"5.1\" class=\"go-footer go-dark\" group=\"Custom\" global once=\"footers\">\n  <mbr-parameters>\n    <header>Colors</header>\n    <input type=\"color\" title=\"Accent\" name=\"accentColor\" value=\"#23dcfc\">\n  </mbr-parameters>\n  <div class=\"go-fwrap\">\n    <div class=\"go-fcta\">\n      <h2 mbr-text>מוכנים לעלות<span>למגרש?</span></h2>\n      <div class=\"go-fbtns\"><a class=\"go-btn go-btn-main\" href=\"index.html#contact\" mbr-text>לפרטים והרשמה</a><a class=\"go-btn go-btn-wa\" href=\"https://wa.me/972547733821\" target=\"_blank\" rel=\"noopener\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"currentColor\"><path d=\"M12.04 2a9.9 9.9 0 0 0-8.5 15l-1.4 5 5.1-1.3A9.9 9.9 0 1 0 12.04 2Zm0 18.1a8.2 8.2 0 0 1-4.2-1.15l-.3-.18-3 .8.8-2.95-.2-.3a8.2 8.2 0 1 1 6.9 3.78Zm4.5-6.13c-.25-.12-1.46-.72-1.69-.8-.23-.08-.39-.12-.56.12-.16.25-.64.8-.78.97-.15.16-.29.18-.54.06a6.7 6.7 0 0 1-3.32-2.9c-.25-.43.25-.4.72-1.33.08-.16.04-.3-.02-.43l-.76-1.83c-.2-.48-.4-.41-.56-.42h-.47a.9.9 0 0 0-.66.31 2.76 2.76 0 0 0-.86 2.06 4.8 4.8 0 0 0 1 2.55 11 11 0 0 0 4.2 3.7c1.56.68 2.18.73 2.96.62.48-.07 1.46-.6 1.67-1.18.2-.58.2-1.07.15-1.18-.07-.1-.23-.16-.48-.29Z\"/></svg><span mbr-text>וואטסאפ למני</span></a></div>\n    </div>\n    <div class=\"go-fgrid\">\n      <div class=\"go-fbrand\">\n        <a href=\"index.html\" class=\"go-flogo\" aria-label=\"גולאסו, דף הבית\"><img src=\"@PROJECT_PATH@/assets/images/logo-golazo-192.png\" alt=\"\" width=\"173\" height=\"192\"><span aria-hidden=\"true\">גולאסו</span></a>\n        <p class=\"go-ftext\" mbr-text>בית ספר לכדורגל בבאר שבע: אימוני כדורגל לילדים, ימי הולדת כדורגל, אימונים אישיים, ימי גיבוש ומחנה קיץ.</p>\n        <div class=\"go-fsocial\">\n          <a href=\"https://www.facebook.com/p/%D7%92%D7%95%D7%9C%D7%90%D7%A1%D7%95-%D7%94%D7%A4%D7%A2%D7%9C%D7%95%D7%AA-%D7%A1%D7%A4%D7%95%D7%A8%D7%98-%D7%95%D7%90%D7%99%D7%9E%D7%95%D7%A0%D7%99-%D7%9B%D7%93%D7%95%D7%A8%D7%92%D7%9C-100063978907753/\" target=\"_blank\" rel=\"noopener\" aria-label=\"פייסבוק\"><span class=\"socicon socicon-facebook mbr-iconfont\" aria-hidden=\"true\"></span></a>\n          <a href=\"https://www.instagram.com/golasso_b7/\" target=\"_blank\" rel=\"noopener\" aria-label=\"אינסטגרם\"><span class=\"socicon socicon-instagram mbr-iconfont\" aria-hidden=\"true\"></span></a>\n          <a href=\"https://wa.me/972547733821\" target=\"_blank\" rel=\"noopener\" aria-label=\"וואטסאפ\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"currentColor\"><path d=\"M12.04 2a9.9 9.9 0 0 0-8.5 15l-1.4 5 5.1-1.3A9.9 9.9 0 1 0 12.04 2Zm0 18.1a8.2 8.2 0 0 1-4.2-1.15l-.3-.18-3 .8.8-2.95-.2-.3a8.2 8.2 0 1 1 6.9 3.78Zm4.5-6.13c-.25-.12-1.46-.72-1.69-.8-.23-.08-.39-.12-.56.12-.16.25-.64.8-.78.97-.15.16-.29.18-.54.06a6.7 6.7 0 0 1-3.32-2.9c-.25-.43.25-.4.72-1.33.08-.16.04-.3-.02-.43l-.76-1.83c-.2-.48-.4-.41-.56-.42h-.47a.9.9 0 0 0-.66.31 2.76 2.76 0 0 0-.86 2.06 4.8 4.8 0 0 0 1 2.55 11 11 0 0 0 4.2 3.7c1.56.68 2.18.73 2.96.62.48-.07 1.46-.6 1.67-1.18.2-.58.2-1.07.15-1.18-.07-.1-.23-.16-.48-.29Z\"/></svg></a>\n        </div>\n      </div>\n      <div class=\"go-fcol\">\n        <h3 class=\"go-fhead\" mbr-text>ניווט</h3>\n        <ul><li><a href=\"index.html\">דף הבית</a></li><li><a href=\"services.html\">השירותים שלנו</a></li><li><a href=\"index.html#why\">למה אצלנו</a></li><li><a href=\"index.html#reviews\">הורים ממליצים</a></li><li><a href=\"index.html#faq\">שאלות נפוצות</a></li></ul>\n      </div>\n      <div class=\"go-fcol\">\n        <h3 class=\"go-fhead\" mbr-text>השירותים</h3>\n        <ul><li><a href=\"services.html#football-school\">בית הספר לכדורגל</a></li><li><a href=\"services.html#birthday\">ימי הולדת כדורגל</a></li><li><a href=\"services.html#private-training\">אימונים אישיים</a></li><li><a href=\"services.html#team-days\">ימי גיבוש והפעלות ספורט</a></li><li><a href=\"services.html#summer-camp\">מחנה קיץ</a></li></ul>\n      </div>\n      <div class=\"go-fcol\">\n        <h3 class=\"go-fhead\" mbr-text>צרו קשר</h3>\n        <ul><li><a href=\"tel:+972547733821\" dir=\"ltr\">054-773-3821</a></li><li><a href=\"mailto:Mani281279@gmail.com\">Mani281279@gmail.com</a></li><li><span>באר שבע</span></li></ul>\n      </div>\n    </div>\n    <div class=\"go-fbottom\">\n      <p mbr-text>© כל הזכויות שמורות לגולאסו</p>\n      <p><a href=\"privacy.html\">מדיניות פרטיות</a> · <a href=\"terms.html\">תנאי שימוש</a> · <a href=\"accessibility.html\">הצהרת נגישות</a></p>\n    </div>\n  </div>\n  <div class=\"go-fcredit\"><a href=\"https://thebwas.com\" target=\"_blank\" rel=\"noopener\">האתר נבנה על ידי עמית שכטר</a>, <a href=\"tel:+972537155757\" dir=\"ltr\">053-715-5757</a></div>\n</section>",
