          "_customHTML": "<section data-bs-version=\"5.1\" class=\"go-nav\" group=\"Custom\" global once=\"menu\" always-top not-draggable>\n  <mbr-parameters>\n    <header>Colors</header>\n    <input type=\"color\" title=\"Accent\" name=\"accentColor\" value=\"#23dcfc\">\n  </mbr-parameters>\n  <input type=\"checkbox\" id=\"goNavToggle\" class=\"go-toggle\" aria-label=\"פתיחת התפריט\">\n  <div class=\"go-bar\">\n    <a class=\"go-logo\" href=\"index.html\" aria-label=\"גולאסו, דף הבית\"><img src=\"@PROJECT_PATH@/assets/images/logo-golazo.webp\" alt=\"\" width=\"469\" height=\"520\"><span class=\"go-logo-name\" aria-hidden=\"true\">גולאסו</span></a>\n    <nav class=\"go-menu\" aria-label=\"תפריט ראשי\"><ul class=\"go-links\"><li class=\"go-has-sub\"><a class=\"go-link\" href=\"services.html\" mbr-text>השירותים שלנו</a><ul class=\"go-sub\"><li><a class=\"go-sublink\" href=\"services.html#football-school\" mbr-text>בית הספר לכדורגל</a></li><li><a class=\"go-sublink\" href=\"services.html#birthday\" mbr-text>ימי הולדת כדורגל</a></li><li><a class=\"go-sublink\" href=\"services.html#private-training\" mbr-text>אימונים אישיים</a></li><li><a class=\"go-sublink\" href=\"services.html#team-days\" mbr-text>ימי גיבוש והפעלות ספורט</a></li><li><a class=\"go-sublink\" href=\"services.html#summer-camp\" mbr-text>מחנה קיץ</a></li><li><a class=\"go-sublink go-suball\" href=\"services.html\" mbr-text>כל השירותים</a></li></ul></li><li><a class=\"go-link\" href=\"index.html#why\" mbr-text>למה אצלנו</a></li><li><a class=\"go-link\" href=\"index.html#reviews\" mbr-text>הורים ממליצים</a></li><li><a class=\"go-link\" href=\"index.html#gallery\" mbr-text>גלריה</a></li><li><a class=\"go-link\" href=\"index.html#faq\" mbr-text>שאלות נפוצות</a></li><li><a class=\"go-link\" href=\"index.html#contact\" mbr-text>צרו קשר</a></li></ul></nav>\n    <div class=\"go-actions\">\n      <a class=\"go-phone\" href=\"tel:+972547733821\" aria-label=\"054-773-3821 התקשרו\"><i><svg viewBox=\"0 0 24 24\" aria-