    "global_footer_custom": "<script>document.addEventListener(\"DOMContentLoaded\",function(){var d=document.documentElement,b=document.body;\nif(!document.getElementById(\"main\")){var nav=b.querySelector(\"section.go-nav\"),foot=b.querySelector(\"section.go-footer\");var m=document.createElement(\"main\");m.id=\"main\";m.tabIndex=-1;var s=[].slice.call(b.children).filter(function(e){return e.tagName===\"SECTION\"&&e!==nav&&e!==foot});if(s.length){s[0].parentNode.insertBefore(m,s[0]);s.forEach(function(e){m.appendChild(e)})}if(nav)nav.setAttribute(\"role\",\"banner\");if(foot)foot.setAttribute(\"role\",\"contentinfo\")}\nvar a=document.createElement(\"a\");a.className=\"go-skip\";a.href=\"#main\";a.textContent=\"דלג לתוכן הראשי\";b.insertBefore(a,b.firstChild);\nvar cw=document.getElementById(\"chatbutton-wa\");if(cw){cw.setAttribute(\"role\",\"complementary\");cw.setAttribute(\"aria-label\",\"צ'אט וואטסאפ\")}\nvar wa=document.querySelector(\"#chatbutton-wa .floating-wpp-button\");if(wa){wa.setAttribute(\"role\",\"button\");wa.setAttribute(\"tabindex\",\"0\");wa.setAttribute(\"aria-label\",\"שיחת וואטסאפ עם גולאסו\");wa.addEventListener(\"keydown\",function(e){if(e.key===\"Enter\"||e.key===\" \"){e.preventDefault();wa.click()}})}\nvar tg=document.getElementById(\"goNavToggle\");function closeMenu(f){if(tg&&tg.checked){tg.checked=false;d.classList.remove(\"go-menu-open\");if(f)tg.focus()}}\nif(tg)tg.addEventListener(\"change\",function(){d.classList.toggle(\"go-menu-open\",tg.checked);if(tg.checked){var f=document.querySelector(\".go-panel a\");if(f)setTimeout(function(){f.focus()},60)}});\ndocument.addEventListener(\"click\",function(e){if(e.target.closest&&e.target.closest(\".go-panel a\"))closeMenu()});\ndocument.addEventListener(\"keydown\",function(e){if(e.key===\"Escape\")closeMenu(true)});\nvar last=scrollY;addEventListener(\"scroll\",function(){var y=scrollY;d.classList.toggle(\"go-nav-hide\",y>last&&y>260&&!(tg&&tg.checked));d.classList.toggle(\"go-scrolle