      "components": [
        {
          "_name": "go-nav",
          "_sourceTheme": "gumm5",
          "_styles": {
            "position": "sticky",
            "top": "0",
            "z-index": "1030",
            "direction": "rtl",
            "padding": "0",
            "background": "rgba(1, 24, 78, .9)",
            "-webkit-backdrop-filter": "saturate(160%) blur(14px)",
            "backdrop-filter": "saturate(160%) blur(14px)",
            "border-bottom": "1px solid rgba(111, 208, 255, .18)",
            ".go-toggle": {
              "position": "absolute",
              "opacity": "0",
              "pointer-events": "none",
              "width": "1px",
              "height": "1px"
            },
            "@media (min-width: 992px)": {
              ".go-toggle": {
                "display": "none"
              }
            },
            ".go-bar": {
              "max-width": "1320px",
              "margin": "0 auto",
              "height": "82px",
              "padding": "0 clamp(16px, 3vw, 40px)",
              "display": "flex",
              "align-items": "center",
              "justify-content": "space-between",
              "gap": "18px"
            },
            ".go-logo": {
              "display": "flex",
              "align-items": "center",
              "gap": "12px",
              "flex": "none",
              "text-decoration": "none !important"
            },
            ".go-logo img": {
              "height": "60px",
              "width": "auto",
              "display": "block",
              "border-radius": "0",
              "filter": "drop-shadow(0 6px 12px rgba(0, 0, 0, .35))",
              "transition": "transform .4s cubic-bezier(.34,1.56,.64,1)"
            },
            ".go-logo:hover img": {
              "transform": "rotate(-8deg) scale(1.06)"
            },
            ".go-logo-name": {
              "font-family": "'Karantina', sans-serif",
              "font-weight": "700",
              "font-size": "2.1rem",
              "line-height": "1",
              "color": "#ffffff"
            },
            ".go-links": {
              "display": "flex",
              "align-items": "center",
              "gap": "2px",
              "list-style": "none",
              "margin": "0",
              "padding": "0"
            },
            ".go-links li": {
              "position": "relative"
            },
            ".go-link": {
              "display": "block",
              "padding": "9px 13px",
              "border-radius": "999px",
              "color": "#ffffff !important",
              "font-weight": "500",
              "font-size": "1rem",
              "text-decoration": "none !important",
              "transition": "background .25s, color .25s"
            },
            ".go-link:hover, .go-link:focus-visible": {
              "background": "rgba(111, 208, 255, .16)",
              "color": "#6fd0ff !important"
            },
            ".go-has-sub > .go-link::after": {
              "content": "''",
              "display": "inline-block",
              "width": "6px",
              "height": "6px",
              "margin-right": "8px",
              "border-left": "2px solid currentColor",
              "border-bottom": "2px solid currentColor",
              "transform": "translateY(-3px) rotate(-45deg)"
            },
            ".go-sub": {
              "position": "absolute",
              "top": "calc(100% + 10px)",
              "right": "0",
              "min-width": "250px",
              "list-style": "none",
              "margin": "0",
              "padding": "10px",
              "background": "#ffffff",
              "border-radius": "20px",
              "box-shadow": "0 30px 60px -28px rgba(1, 24, 78, .6)",
              "opacity": "0",
              "visibility": "hidden",
              "transform": "translateY(8px)",
              "transition": "opacity .25s, transform .25s, visibility .25s"
            },
            ".go-sub::before": {
              "content": "''",
              "position": "absolute",
              "top": "-12px",
              "right": "0",
              "left": "0",
              "height": "12px"
            },
            ".go-has-sub:hover .go-sub, .go-has-sub:focus-within .go-sub": {
