                "padding": "0 0 12px",
                "display": "flex",
                "flex-wrap": "wrap",
                "gap": "8px",
                "min-width": "0"
              },
              ".go-plinks .go-sub li": {
                "list-style": "none"
              },
              ".go-plinks .go-sublink": {
                "padding": "9px 14px",
