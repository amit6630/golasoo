    "global_header_custom": "<link rel=\"icon\" type=\"image/png\" href=\"assets/images/logo-golazo-192.png\">\n<link rel=\"apple-touch-icon\" href=\"assets/images/logo-golazo-192.png\">\n<style id=\"go-global\">html{scrollbar-width:none;-ms-overflow-style:none;scroll-padding-top:96px}html::-webkit-scrollbar,body::-webkit-scrollbar{width:0;height:0;display:none}body{overflow-x:hidden;font-family:'Rubik',sans-serif;color:#1d2945;background:#fff}p,h1,h2,h3,h4,h5,h6,li,label,input,textarea,select,blockquote,summary,figcaption{direction:rtl;unicode-bidi:plaintext}.go-skip{position:fixed;top:10px;right:10px;z-index:2147483647;padding:12px 18px;border-radius:12px;background:#01184e;color:#fff!important;font-weight:600;text-decoration:none;transform:translateY(-220%);transition:transform .2s}.go-skip:focus{transform:none}:focus-visible{outline:3px solid #0a58c9!important;outline-offset:3px!important;box-shadow:0 0 0 6px #fff!important}.go-dark :focus-visible,.go-nav :focus-visible,.go-footer :focus-visible,.go-hero :focus-visible,.go-phero :focus-visible{outline-color:#23dcfc!important;box-shadow:0 0 0 6px #01184e!important}.go-nav{transition:transform .45s cubic-bezier(.22,1,.36,1)}html.go-nav-hide .go-nav{transform:translateY(-100%)}html.go-menu-open{overflow:hidden}/* reveal on scroll: only after the script runs, so Mobirise's editor and no-JS show everything */ html.go-js [data-go-reveal]{opacity:0;transform:translateY(34px);transition:opacity .9s cubic-bezier(.22,1,.36,1),transform 1s cubic-bezier(.22,1,.36,1);transition-delay:var(--d,0s)}html.go-js [data-go-reveal].go-in{opacity:1;transform:none}html.go-js [data-go-reveal=\"zoom\"]{transform:scale(.94)}html.go-js [data-go-reveal=\"zoom\"].go-in{transform:none}.go-chalk path,.go-chalk circle,.go-chalk line,.go-chalk rect{stroke-dasharray:1;stroke-dashoffset:0}html.go-js .go-chalk path,html.go-js .go-chalk circle,html.go-js .go-chalk line,html.go-js .go-chalk rect{stroke-dashoffset:1}html.go-js.go-ready .go-chalk path,html.go-js.go-ready .go-chalk circle,html.go-js.go-ready .go-chalk line,html.go-js.go-ready .go-chalk rect{animation:goDraw 2.4s cubic-bezier(.65,0,.35,1) forwards;animation-delay:var(--d,.2s)}@keyframes goDraw{to{stroke-dashoffset:0}}.go-float{animation:goFloat 6s ease-in-out infinite}@keyframes goFloat{0%,100%{transform:translateY(0) rotate(-2deg)}50%{transform:translateY(-14px) rotate(2deg)}}.go-spin{animation:goSpin 14s linear infinite}@keyframes goSpin{to{transform:rotate(360deg)}}@keyframes goWheel{0%{transform:translateY(0);opacity:1}70%{transform:translateY(12px);opacity:0}100%{opacity:0}}/* opening: navy curtain, chalk centre circle, the shield, the name, then a wipe up */ html.go-pl::before{content:\"\";position:fixed;inset:0;z-index:2147483646;background:#01184e}html.go-pl.go-mounted::before{display:none}html.go-pl body{overflow:hidden}#go-pl{position:fixed;inset:0;z-index:2147483647;display:grid;place-items:center;overflow:hidden;color:#fff;direction:rtl;background:radial-gradient(900px 620px at 50% 40%,rgba(42,168,255,.28),transparent 70%),url(\"assets/images/texture-marble-navy.webp\") center/cover,#01184e;clip-path:inset(0 0 0 0);transition:clip-path 1.05s cubic-bezier(.77,0,.18,1);animation:goFail 0s 6s forwards}#go-pl.is-out{clip-path:inset(0 0 100% 0);pointer-events:none}#go-pl.is-in{clip-path:inset(100% 0 0 0);animation:goIn .55s cubic-bezier(.77,0,.18,1) forwards}@keyframes goIn{to{clip-path:inset(0 0 0 0)}}@keyframes goFail{to{clip-path:inset(0 0 100% 0);pointer-events:none}}.go-pl-pitch{position:absolute;inset:0;width:100%;height:100%;opacity:.5}.go-pl-pitch circle,.go-pl-pitch line{fill:none;stroke:#bfe9ff;stroke-width:2;stroke-dasharray:1;stroke-dashoffset:1;animation:goDraw 1.5s cubic-bezier(.65,0,.35,1) .05s forwards}.go-pl-inner{position:relative;display:grid;justify-items:center;gap:.4rem;text-align:center;transition:opacity .55s ease,transform .7s cubic-bezier(.22,1,.36,1)}#go-pl.is-out .go-pl-inner{opacity:0;transform:translateY(-40px) scale(.96)}.go-pl-logo{width:clamp(110px,18vw,150px);height:auto;margin-bottom:.6rem;animation:goPop .9s cubic-bezier(.34,1.56,.64,1) .15s both;filter:drop-shadow(0 18px 30px rgba(0,0,0,.35))}@keyframes goPop{from{opacity:0;transform:scale(.4) rotate(-14deg)}to{opacity:1;transform:none}}.go-pl-line{display:block;overflow:hidden;padding:.05em 0}.go-pl-line>span{display:block;animation:goUp .95s cubic-bezier(.22,1,.36,1) both}.go-pl-name>span{font:700 clamp(3.6rem,13vw,7.5rem)/.9 'Karantina',sans-serif;letter-spacing:.01em;animation-delay:.35s}.go-pl-role>span{font:400 clamp(.95rem,2.6vw,1.15rem)/1.5 'Rubik',sans-serif;color:#cfeaff;animation-delay:.5s}.go-pl-bar{width:190px;height:3px;margin-top:1rem;border-radius:3px;overflow:hidden;background:rgba(255,255,255,.16)}.go-pl-bar i{display:block;height:100%;background:linear-gradient(90deg,#23dcfc,#2aa8ff);transform-origin:right;animation:goBar 1.25s cubic-bezier(.77,0,.18,1) .3s both}#go-pl.is-quick .go-pl-line>span,#go-pl.is-quick .go-pl-logo{animation-duration:.6s;animation-delay:0s}#go-pl.is-quick .go-pl-bar i{animation-duration:.6s;animation-delay:0s}#go-pl.is-in .go-pl-line>span,#go-pl.is-in .go-pl-bar i,#go-pl.is-in .go-pl-logo,#go-pl.is-in .go-pl-pitch *{animation:none;opacity:1;transform:none;stroke-dashoffset:0}@keyframes goUp{from{transform:translateY(110%)}to{transform:none}}@keyframes goBar{from{transform:scaleX(0)}to{transform:scaleX(1)}}/* desktop cursor: a small ball that grows over anything clickable */ #go-cursor{position:fixed;top:0;left:0;z-index:2147483645;width:34px;height:34px;margin:-17px 0 0 -17px;border-radius:50%;pointer-events:none;background:url(\"assets/images/cursor-ball.svg\") center/contain no-repeat;transition:width .25s,height .25s,margin .25s,opacity .25s;opacity:0}#go-cursor.is-on{opacity:1}#go-cursor.is-big{width:58px;height:58px;margin:-29px 0 0 -29px}#go-cursor.is-on.is-big{opacity:.45}.mbr-arrow-up,#scrollToTop{display:none!important}#chatbutton-wa .floating-wpp-button{box-shadow:0 14px 30px -12px rgba(1,24,78,.6)!important}@media (prefers-reduced-motion:reduce){html.go-pl::before,#go-pl,#go-cursor{display:none!important}html.go-pl body{overflow:auto}*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}html.go-js [data-go-reveal]{opacity:1;transform:none}.go-chalk *{stroke-dashoffset:0!important}}.a11y{direction:rtl;font-family:'Rubik',sans-serif}.a11y button{font-family:inherit;cursor:pointer;border:0;background:none;padding:0;margin:0;line-height:1.2}.a11y__toggle{position:fixed;z-index:1040;top:50%;right:0;display:grid!important;place-items:center;width:48px;height:52px;transform:translateY(-50%);border-radius:12px 0 0 12px!important;background:#23dcfc!important;color:#01184e;border:2px solid #01184e!important;border-left:0!important;box-shadow:0 10px 24px -8px rgba(1,24,78,.7);transition:width .3s,background-color .3s}.a11y__toggle svg{width:26px;height:26px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.a11y__toggle svg circle{fill:currentColor;stroke:none}.a11y__toggle:hover,.a11y__toggle:focus-visible,.a11y__toggle[aria-expanded=\"true\"]{width:56px;background:#ffffff!important}.a11y__panel{position:fixed;z-index:1041;top:50%;right:64px;width:min(340px,calc(100vw - 80px));max-height:calc(100vh - 40px);overflow-y:auto;transform:translateY(-50%);padding:18px;border-radius:20px;background:#f3f6fb;border:1px solid #cfdcf1;box-shadow:0 30px 70px -20px rgba(1,24,78,.6);color:#1d2945;font-size:15px;line-height:1.4;text-align:right}.a11y__panel[hidden]{display:none}.a11y__head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}.a11y__title{margin:0;font-family:'Karantina',sans-serif;font-weight:700;font-size:28px;line-height:1;color:#01184e}.a11y__close{display:grid!important;place-items:center;width:44px;height:44px;border-radius:50%!important;color:#01184e}.a11y__close:hover{background:rgba(1,24,78,.08)!important}.a11y__close svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round}.a11y__size{display:grid;grid-template-columns:minmax(0,1fr) auto auto auto;align-items:center;gap:8px;margin-bottom:12px;padding:10px 12px;border-radius:14px;background:#fff;border:1px solid #dfe8f5}.a11y__size-label{font-weight:600;color:#01184e}.a11y__step{width:44px;height:44px;border-radius:12px!important;background:#01184e!important;color:#fff;font-weight:700;font-size:16px}.a11y__step:hover{background:#0a3a8c!important}.a11y__step:disabled{opacity:.4;cursor:default}.a11y__size-value{min-width:48px;text-align:center;font-weight:700;color:#01184e}.a11y__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.a11y__opt{display:grid!important;justify-items:center;gap:6px;min-height:84px;padding:12px 8px!important;border-radius:14px!important;border:1.5px solid #dfe8f5!important;background:#fff!important;color:#01184e;font-size:14px;font-weight:600;text-align:center;transition:background-color .25s,border-color .25s,color .25s}.a11y__opt svg{width:26px;height:26px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}.a11y__opt svg .fill{fill:currentColor}.a11y__opt:hover{border-color:#0a58c9!important}.a11y__opt[aria-pressed=\"true\"]{background:#01184e!important;border-color:#01184e!important;color:#fff}.a11y__foot{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:14px;padding-top:12px;border-top:1px solid #dfe8f5}.a11y__reset{min-height:44px;padding:0 16px!important;border-radius:999px!important;border:1.5px solid #c3d1e6!important;font-weight:600;color:#01184e}.a11y__reset:hover{background:rgba(1,24,78,.06)!important}.a11y__statement{min-height:44px;display:inline-flex;align-items:center;color:#0a58c9!important;text-decoration:underline;text-underline-offset:3px}@media (max-width:767px){.a11y__toggle{width:42px;height:4