            ".go-wrap": {
              "max-width": "1320px",
              "margin": "0 auto",
              "padding": "0 clamp(16px, 4vw, 48px)",
              "display": "grid",
              "grid-template-columns": "1.05fr .95fr",
              "gap": "clamp(28px, 5vw, 70px)",
              "align-items": "center"
            },
            ".go-rev .go-media": {
              "order": "-1"
            },
            ".go-pill": {
              "display": "inline-block",
              "margin": "18px 0 0",
              "padding": "8px 16px",
              "border-radius": "999px",
              "background": "#eef4fd",
              "border": "1px solid #cfdcf1",
              "color": "#01184e",
              "font-weight": "600",
              "font-size": ".97rem"
            },
            ".go-list": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr",
              "gap": "10px",
              "margin": "22px 0 0",
              "padding": "0",
              "list-style": "none",
              "counter-reset": "go"
            },
            ".go-li": {
              "position": "relative",
              "padding": "12px 14px",
              "padding-right": "52px",
              "border-radius": "18px",
              "background": "#f3f6fb",
              "border": "1px solid #e1e9f5",
              "counter-increment": "go"
            },
            ".go-li::before": {
              "content": "counter(go)",
              "position": "absolute",
              "top": "12px",
              "right": "14px",
              "width": "28px",
              "height": "28px",
              "border-radius": "50%",
              "display": "grid",
              "place-items": "center",
              "background": "#01184e",
              "color": "#ffffff",
              "font-family": "'Karantina', sans-serif",
              "font-size": "1.15rem",
              "font-weight": "700",
              "line-height": "1"
            },
            ".go-li b": {
              "display": "block",
              "margin-bottom": "2px",
              "font-weight": "600",
              "color": "#01184e"
            },
            ".go-li span": {
              "display": "block",
              "font-size": ".96rem",
              "line-height": "1.6",
              "color": "#3b4766"
            },
            ".go-motto": {
              "margin": "20px 0 0",
              "padding-right": "16px",
              "border-right": "4px solid #0a58c9",
              "font-family": "'Karantina', sans-serif",
              "font-size": "clamp(1.7rem, 2.6vw, 2.2rem)",
              "font-weight": "700",
              "line-height": "1.05",
              "color": "#01184e"
            },
            ".go-btns": {
              "display": "flex",
              "flex-wrap": "wrap",
              "gap": "12px",
              "margin-top": "24px"
            },
            ".go-media": {
              "position": "relative",
              "display": "grid",
              "grid-template-columns": "1fr 1fr",
              "grid-template-rows": "1fr 1fr",
              "gap": "12px",
              "height": "clamp(340px, 33vw, 450px)"
            },
            ".go-media figure": {
              "margin": "0",
              "border-radius": "24px",
              "overflow": "hidden",
              "background": "#01184e",
              "box-shadow": "0 26px 50px -30px rgba(1, 24, 78, .7)"
            },
            ".go-media figure:first-child": {
              "grid-row": "1 / 3"
            },
            ".go-media figure img": {
              "width": "100%",
              "height": "100%",
              "object-fit": "cover",
              "border-radius": "0",
              "display": "block",
              "transition": "transform 1.1s cubic-bezier(.22,1,.36,1)"
            },
            ".go-media figure:hover img": {
              "transform": "scale(1.06)"
            },
            ".go-ball": {
              "position": "absolute",
              "bottom": "-22px",
              "left": "-18px",
              "width": "86px",
              "height": "86px",
              "pointer-events": "none",
              "border-radius": "0",
              "z-index": "2",
              "filter": "drop-shadow(0 14px 20px rgba(1, 24, 78, .45))"
            },
            "@media (max-width: 991px)": {
              ".go-wrap": {
                "grid-template-columns": "1fr"
              },
              ".go-rev .go-media": {
                "order": "0"
              },
              ".go-media": {
                "height": "340px"
              }
            },
            "@media (max-width: 575px)": {
              ".go-list": {
                "grid-template-columns": "1fr"
              },
              ".go-media": {
                "height": "260px",
                "gap": "8px"
              },
              ".go-btns .go-btn": {
                "flex": "1 1 100%"
              },
              ".go-ball": {
                "width": "64px",
                "height": "64px",
                "bottom": "-16px",
                "left": "-6px"
              }
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"go-svc\" group=\"Custom\" mbr-class=\"{'go-dark': dark}\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n    <header>Layout</header>\n    <input type=\"checkbox\" title=\"Images first\" name=\"reverse\" checked>\n    <input type=\"checkbox\" title=\"Dark\" name=\"dark\" checked>\n    <header>Background</header>\n    <fieldset type=\"background\" name=\"bg\">\n      <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/texture-marble-navy.webp\" selected>\n      <input type=\"color\" title=\"Color\" value=\"#ffffff\">\n    </fieldset>\n  </mbr-parameters>\n  <div class=\"go-wrap\" mbr-class=\"{'go-rev': reverse}\">\n    <div class=\"go-text\" data-go-reveal>\n      <p class=\"go-kick\"><b>02</b><span mbr-text>ימי הולדת כדורגל וספורט</span></p>\n      <h2 class=\"go-title\" mbr-text>חוגגים יום הולדת<span>בגולאסו</span></h2>\n      <p class=\"go-lead\" mbr-text>בגולאסו אנחנו מביאים לכם חוויה מדהימה של ספורט והנאה לילד ולחברים שלו. אז מה יהיה ביום ההולדת?</p>\n      <p class=\"go-pill\" mbr-text>משך הפעילות: כ-90 דקות</p>\n      <ul class=\"go-list\"><li class=\"go-li\"><span mbr-text>הפעלת כדורגל או ספורט עם מאמן מקצועי, שילמד וינחה את הילדים בצורה מהנה ומקצועית.</span></li><li class=\"go-li\"><span mbr-text>ציוד חדיש וייחודי שמותאם לכל ילד וילדה.</span></li><li class=\"go-li\"><span mbr-text>כל חוגג מקבל את הכבוד של קפטן הקבוצה.</span></li><li class=\"go-li\"><span mbr-text>מוזיקה והגברה בכל שלבי הפעילות.</span></li><li class=\"go-li\"><span mbr-text>פרסים והפתעות לכל הילדים.</span></li><li class=\"go-li\"><span mbr-text>גביע מכובד לחוגג, ומדליות לכל הילדים על ההשתתפות.</span></li></ul>\n      <p class=\"go-motto\" mbr-text>אל תחמיצו חוויית יום הולדת מושלמת!</p>\n      <div class=\"go-btns\"><a class=\"go-btn go-btn-main\" href=\"index.html#contact\" mbr-text>להזמנת יום הולדת</a><a class=\"go-btn go-btn-line\" href=\"https://wa.me/972547733821\" target=\"_blank\" rel=\"noopener\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"currentColor\"><path d=\"M12.04 2a9.9 9.9 0 0 0-8.5 15l-1.4 5 5.1-1.3A9.9 9.9 0 1 0 12.04 2Zm0 18.1a8.2 8.2 0 0 1-4.2-1.15l-.3-.18-3 .8.8-2.95-.2-.3a8.2 8.2 0 1 1 6.9 3.78Zm4.5-6.13c-.25-.12-1.46-.72-1.69-.8-.23-.08-.39-.12-.56.12-.16.25-.64.8-.78.97-.15.16-.29.18-.54.06a6.7 6.7 0 0 1-3.32-2.9c-.25-.43.25-.4.72-1.33.08-.16.04-.3-.02-.43l-.76-1.83c-.2-.48-.4-.41-.56-.42h-.47a.9.9 0 0 0-.66.31 2.76 2.76 0 0 0-.86 2.06 4.8 4.8 0 0 0 1 2.55 11 11 0 0 0 4.2 3.7c1.56.68 2.18.73 2.96.62.48-.07 1.46-.6 1.67-1.18.2-.58.2-1.07.15-1.18-.07-.1-.23-.16-.48-.29Z\"/></svg><span mbr-text>שאלו בוואטסאפ</span></a></div>\n    </div>\n    <div class=\"go-media\"><figure data-go-reveal=\"zoom\" style=\"--d:0.00s\"><img src=\"@PROJECT_PATH@/assets/images/birthday-group.webp\" alt=\"ילדים בתמונה קבוצתית ביום הולדת כדורגל\" width=\"1200\" height=\"1200\" loading=\"lazy\"></figure><figure data-go-reveal=\"zoom\" style=\"--d:0.10s\"><img src=\"@PROJECT_PATH@/assets/images/birthday-kids.webp\" alt=\"ילדים בתרגיל זריזות עם סולם אימון\" width=\"820\" height=\"1093\" loading=\"lazy\"></figure><figure data-go-reveal=\"zoom\" style=\"--d:0.20s\"><img src=\"@PROJECT_PATH@/assets/images/school-red-team.webp\" alt=\"קבוצת ילדים בחולצות אדומות\" width=\"1600\" height=\"747\" loading=\"lazy\"></figure><img class=\"go-ball go-float\" src=\"@PROJECT_PATH@/assets/images/ball.svg\" alt=\"\" width=\"86\" height=\"86\"></div>\n  </div>\n</section>",
          "_anchor": "birthday",
          "_cid": "waZOjBeJOG",
