              "color": "#ffffff"
            },
            ".go-fcta h2 span": {
              "display": "block",
              "color": "#23dcfc"
            },
            ".go-fbtns": {
              "display": "flex",
              "flex-wrap": "wrap",
              "gap": "12px"
            },
            ".go-fgrid": {
              "display": "grid",
              "grid-template-columns": "1.4fr 1fr 1fr 1.1fr",
              "gap": "36px"
            },
            ".go-flogo": {
              "display": "inline-flex",
              "align-items": "center",
              "gap": "12px",
              "text-decoration": "none !important"
            },
            ".go-flogo img": {
              "width": "78px",
              "height": "auto",
              "border-radius": "0"
            },
            ".go-flogo span": {
              "font-family": "'Karantina', sans-serif",
              "font-weight": "700",
              "font-size": "2.4rem",
              "color": "#ffffff"
            },
            ".go-ftext": {
              "margin": "14px 0 16px",
              "line-height": "1.7",
              "font-size": ".98rem",
              "max-width": "32ch",
              "color": "#c9d8f0"
            },
            ".go-fsocial": {
              "display": "flex",
              "gap": "10px"
            },
            ".go-fsocial a": {
              "width": "44px",
              "height": "44px",
              "border-radius": "50%",
              "display": "inline-grid",
              "place-items": "center",
              "border": "1px solid rgba(255, 255, 255, .25)",
              "color": "#ffffff !important",
              "text-decoration": "none !important",
              "transition": "background .25s, color .25s"
            },
            ".go-fsocial a:hover": {
              "background": "#23dcfc",
              "color": "#01184e !important"
            },
            ".go-fsocial svg": {
              "width": "20px",
              "height": "20px"
            },
            ".go-fhead": {
              "margin": "6px 0 14px",
              "color": "#ffffff",
              "font-size": "1.1rem",
              "font-weight": "600"
            },
            ".go-fcol ul": {
              "list-style": "none",
              "margin": "0",
              "padding": "0"
            },
            ".go-fcol li": {
              "margin-bottom": "9px"
            },
            ".go-fcol a, .go-fcol span": {
              "color": "#c9d8f0 !important",
              "text-decoration": "none !important",
              "font-size": ".98rem"
            },
            ".go-fcol a:hover": {
              "color": "#6fd0ff !important"
            },
            ".go-fbottom": {
              "display": "flex",
              "flex-wrap": "wrap",
              "justify-content": "space-between",
              "gap": "10px",
              "margin": "40px 0 0",
              "padding": "18px 0 22px",
              "border-top": "1px solid rgba(255, 255, 255, .12)",
