        {
          "_name": "go-footer",
          "_sourceTheme": "gumm5",
          "_styles": {
            "direction": "rtl",
            "padding": "clamp(50px, 6vw, 76px) 0 0",
            "color": "#c9d8f0",
            "background-color": "#000f33",
            "background-image": "radial-gradient(700px 320px at 85% 0%, rgba(42, 168, 255, .2), transparent 70%)",
            ".go-fwrap": {
              "max-width": "1320px",
              "margin": "0 auto",
              "padding": "0 clamp(16px, 4vw, 48px)"
            },
            ".go-fcta": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "space-between",
              "gap": "24px",
              "padding": "0 0 38px",
              "margin-bottom": "40px",
              "border-bottom": "1px solid rgba(255, 255, 255, .12)"
            },
            ".go-fcta h2": {
              "margin": "0",
              "font-family": "'Karantina', sans-serif",
              "font-weight": "700",
              "font-size": "clamp(2.6rem, 5vw, 4rem)",
              "line-height": ".92",
              "color": "#ffffff"
            },
            ".go-fcta h2 span": {
              "display": "block",
              "color": "#23dcfc"
            },
            ".go-fbtns": {
              "display": "flex",
              "flex-wrap": "wrap",
              "gap": "12px"
            },
            ".go-fgrid": {
              "display": "grid",
              "grid-template-columns": "1.4fr 1fr 1fr 1.1fr",
              "gap": "36px"
            },
            ".go-flogo": {
              "display": "inline-flex",
              "align-items": "center",
              "gap": "12px",
              "text-decoration": "none !important"
            },
            ".go-flogo img": {
              "width": "78px",
              "height": "auto",
              "border-radius": "0"
            },
            ".go-flogo span": {
              "font-family": "'Karantina', sans-serif",
              "font-weight": "700",
              "font-size": "2.4rem",
              "color": "#ffffff"
            },
            ".go-ftext": {
              "margin": "14px 0 16px",
              "line-height": "1.7",
              "font-size": ".98rem",
              "max-width": "32ch",
              "color": "#c9d8f0"
            },
            ".go-fsocial": {
              "display": "flex",
              "gap": "10px"
            },
            ".go-fsocial a": {
              "width": "44px",
              "height": "44px",
              "border-radius": "50%",
              "display": "inline-grid",
              "place-items": "center",
              "border": "1px solid rgba(255, 255, 255, .25)",
              "color": "#ffffff !important",
              "text-decoration": "none !important",
              "transition": "background .25s, color .25s"
            },
            ".go-fsocial a:hover": {
              "background": "#23dcfc",
              "color": "#01184e !important"
            },
            ".go-fsocial svg": {
              "width": "20px",
              "height": "20px"
            },
            ".go-fhead": {
              "margin": "6px 0 14px",
              "color": "#ffffff",
              "font-size": "1.1rem",
              "font-weight": "600"
            },
            ".go-fcol ul": {
              "list-style": "none",
              "margin": "0",
              "padding": "0"
            },
            ".go-fcol li": {
              "margin-bottom": "9px"
            },
            ".go-fcol a, .go-fcol span": {
              "color": "#c9d8f0 !important",
              "text-decoration": "none !important",
              "font-size": ".98rem"
            },
            ".go-fcol a:hover": {
              "color": "#6fd0ff !important"
            },
            ".go-fbottom": {
              "display": "flex",
              "flex-wrap": "wrap",
              "justify-content": "space-between",
              "gap": "10px",
              "margin": "40px 0 0",
              "padding": "18px 0 22px",
              "border-top": "1px solid rgba(255, 255, 255, .12)",
              "font-size": ".92rem"
            },
            ".go-fbottom p": {
              "margin": "0",
              "color": "#b6c8e6"
            },
            ".go-fbottom a": {
              "color": "#d7e4f8 !important",
              "text-decoration": "none !important"
            },
            ".go-fbottom a:hover": {
              "color": "#6fd0ff !important",
              "text-decoration": "underline !important"
            },
            ".go-fcredit": {
              "text-align": "center",
              "padding": "14px 16px",
              "font-size": ".95rem",
              "background": "#0a3a8c"
            },
            ".go-fcredit a": {
              "color": "#ffffff !important",
              "text-decoration": "none !important",
              "font-weight": "500"
            },
            ".go-fcredit a:hover": {
              "text-decoration": "underline !important"
            },
            ".go-btn": {
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "gap": "10px",
              "min-height": "52px",
              "padding": "12px 26px",
              "border-radius": "999px",
              "font-weight": "600",
              "font-size": "1.05rem",
              "line-height": "1.2",
              "text-decoration": "none !important",
              "transition": "transform .3s cubic-bezier(.22,1,.36,1), box-shadow .3s, background .3s"
            },
            ".go-btn:hover": {
              "transform": "translateY(-2px)"
            },
            ".go-btn-main": {
              "color": "#01184e !important",
              "background": "linear-gradient(120deg, #23dcfc, #6fd0ff)",
              "box-shadow": "0 14px 30px -14px rgba(35, 220, 252, .9)"
            },
            ".go-btn-main:hover": {
              "box-shadow": "0 18px 36px -14px rgba(35, 220, 252, 1)"
            },
            ".go-btn-navy": {
              "color": "#ffffff !important",
              "background": "#01184e",
              "box-shadow": "0 14px 30px -16px rgba(1, 24, 78, .8)"
            },
            ".go-btn-navy:hover": {
              "background": "#0a2f7a"
            },
            ".go-btn-wa": {
              "color": "#ffffff !important",
              "background": "rgba(255, 255, 255, .1)",
              "border": "1.5px solid rgba(255, 255, 255, .55)"
            },
            ".go-btn-wa:hover": {
              "background": "rgba(255, 255, 255, .2)"
            },
            ".go-btn-line": {
              "color": "#01184e !important",
              "background": "transparent",
              "border": "1.5px solid rgba(1, 24, 78, .35)"
            },
            ".go-btn-line:hover": {
              "background": "rgba(1, 24, 78, .06)"
            },
            ".go-btn svg": {
              "width": "20px",
              "height": "20px",
              "flex": "none"
            },
            "@media (max-width: 991px)": {
              ".go-fcta": {
                "flex-direction": "column",
                "align-items": "flex-start"
              },
              ".go-fgrid": {
                "grid-template-columns": "1fr 1fr"
              },
              ".go-fbrand": {
                "grid-column": "1 / -1"
              }
            },
            "@media (max-width: 575px)": {
