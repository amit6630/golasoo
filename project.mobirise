                "transform": "none"
              },
              ".go-plinks": {
                "list-style": "none",
                "margin": "0",
                "padding": "0"
              },
              ".go-plinks > li": {
                "border-bottom": "1px solid rgba(255, 255, 255, .1)"
              },
              ".go-plinks .go-link": {
                "padding": "15px 4px",
                "border-radius": "0",
