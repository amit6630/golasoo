              "gap": "10px",
              "margin": "40px 0 0",
              "padding": "18px 0 22px",
              "border-top": "1px solid rgba(255, 255, 255, .12)",
              "font-size": ".92rem"
            },
            ".go-fbottom p": {
              "margin": "0",
              "color": "#b6c8e6"
            },
            ".go-fbottom a": {
              "color": "#d7e4f8 !important",
              "text-decoration": "none !important"
            },
            ".go-fbottom a:hover": {
              "color": "#6fd0ff !important",
              "text-decoration": "underline !important"
            },
            ".go-fcredit": {
              "text-align": "center",
              "padding": "14px 16px",
              "font-size": ".95rem",
              "background": "#0a3a8c"
            },
            ".go-fcredit a": {
              "color": "#ffffff !important",
              "text-decoration": "none !important",
              "font-weight": "500"
            },
            ".go-fcredit a:hover": {
              "text-decoration": "underline !important"
            },
            ".go-btn": {
              "display": "inline-flex",
              "align-items": "center",
              "justify-content": "center",
              "gap": "10px",
              "min-height": "52px",
              "padding": "12px 26px",
              "border-radius": "999px",
              "font-weight": "600",
              "font-size": "1.05rem",
              "line-height": "1.2",
              "text-decoration": "none !important",
              "transition": "transform .3s cubic-bezier(.22,1,.36,1), box-shadow .3s, background .3s"
            },
            ".go-btn:hover": {
              "transform": "translateY(-2px)"
            },
            ".go-btn-main": {
              "color": "#01184e !important",
              "background": "linear-gradient(120deg, #23dcfc, #6fd0ff)",
              "box-shadow": "0 14px 30px -14px rgba(35, 220, 252, .9)"
            },
            ".go-btn-main:hover": {
              "box-shadow": "0 18px 36px -14px rgba(35, 220, 252, 1)"
            },
            ".go-btn-navy": {
              "color": "#ffffff !important",
              "background": "#01184e",
              "box-shadow": "0 14px 30px -16px rgba(1, 24, 78, .8)"
            },
            ".go-btn-navy:hover": {
              "background": "#0a2f7a"
            },
            ".go-btn-wa": {
              "color": "#ffffff !important",
              "background": "rgba(255, 255, 255, .1)",
              "border": "1.5px solid rgba(255, 255, 255, .55)"
            },
            ".go-btn-wa:hover": {
              "background": "rgba(255, 255, 255, .2)"
            },
            ".go-btn-line": {
              "color": "#01184e !important",
              "background": "transparent",
              "border": "1.5px solid rgba(1, 24, 78, .35)"
            },
            ".go-btn-line:hover": {
              "background": "rgba(1, 24, 78, .06)"
            },
            ".go-btn svg": {
              "width": "20px",
              "height": "20px",
              "flex": "none"
            },
            "@media (max-width: 991px)": {
              ".go-fcta": {
                "flex-direction": "column",
                "align-items": "flex-start"
              },
              ".go-fgrid": {
                "grid-template-columns": "1fr 1fr"
              },
