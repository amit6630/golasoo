              "border-bottom": "2px solid currentColor",
              "transform": "translateY(-3px) rotate(-45deg)"
            },
            ".go-sub": {
              "position": "absolute",
              "top": "calc(100% + 10px)",
              "right": "0",
              "min-width": "250px",
              "list-style": "none",
              "margin": "0",
              "padding": "10px",
