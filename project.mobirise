    "services.html": {
      "settings": {
        "title": "ימי הולדת כדורגל, אימונים אישיים ומחנה קיץ בבאר שבע | גולאסו",
        "meta_descr": "כל הפעילויות של גולאסו בבאר שבע: בית ספר לכדורגל לכיתות א'-ו', ימי הולדת כדורגל של כ-90 דקות, אימונים אישיים, ימי גיבוש והפעלות ספורט ומחנה קיץ.",
        "header_custom": "<!-- seo -->\n<link rel=\"canonical\" href=\"https://gollasso.com/services.html\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:locale\" content=\"he_IL\">\n<meta property=\"og:site_name\" content=\"גולאסו\">\n<meta property=\"og:url\" content=\"https://gollasso.com/services.html\">\n<meta property=\"og:title\" content=\"ימי הולדת כדורגל, אימונים אישיים ומחנה קיץ בבאר שבע | גולאסו\">\n<meta property=\"og:description\" content=\"כל הפעילויות של גולאסו בבאר שבע: בית ספר לכדורגל לכיתות א&#x27;-ו&#x27;, ימי הולדת כדורגל של כ-90 דקות, אימונים אישיים, ימי גיבוש והפעלות ספורט ומחנה קיץ.\">\n<meta property=\"og:image\" content=\"https://gollasso.com/assets/images/og-golazo.jpg\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@graph\": [{\"@type\": \"SportsOrganization\", \"@id\": \"https://gollasso.com/#org\", \"name\": \"גולאסו\", \"alternateName\": \"Golazo\", \"url\": \"https://gollasso.com/\", \"logo\": \"https://gollasso.com/assets/images/logo-golazo.png\", \"image\": \"https://gollasso.com/assets/images/og-golazo.jpg\", \"description\": \"בית ספר לכדורגל לילדים בבאר שבע: אימוני כדורגל, ימי הולדת כדורגל, אימונים אישיים, ימי גיבוש ומחנה קיץ.\", \"sport\": \"Soccer\", \"telephone\": \"+972-54-773-3821\", \"email\": \"Mani281279@gmail.com\", \"address\": {\"@type\": \"PostalAddress\", \"addressLocality\": \"באר שבע\", \"addressRegion\": \"מחוז הדרום\", \"addressCountry\": \"IL\"}, \"areaServed\": {\"@type\": \"City\", \"name\": \"באר שבע\"}, \"sameAs\": [\"https://www.facebook.com/p/%D7%92%D7%95%D7%9C%D7%90%D7%A1%D7%95-%D7%94%D7%A4%D7%A2%D7%9C%D7%95%D7%AA-%D7%A1%D7%A4%D7%95%D7%A8%D7%98-%D7%95%D7%90%D7%99%D7%9E%D7%95%D7%A0%D7%99-%D7%9B%D7%93%D7%95%D7%A8%D7%92%D7%9C-100063978907753/\", \"https://www.instagram.com/golasso_b7/\"]}, {\"@type\": \"Service\", \"name\": \"בית ספר לכדורגל\", \"url\": \"https://gollasso.com/services.html#football-school\", \"serviceType\": \"בית ספר לכדורגל\", \"pro