          "_name": "form1",
          "_sourceTheme": "realtym4",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"form1 realtym4_form1 go-contact\" group=\"Forms\" plugins=\"formstyler, datepicker\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"6\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"6\">\n    <header>Background</header>\n    <fieldset type=\"background\" name=\"bg\">\n      <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/texture-marble-light.webp\" selected>\n      <input type=\"color\" title=\"Color\" value=\"#ffffff\">\n    </fieldset>\n  <input type=\"hidden\" name=\"usedRecaptcha\" value=\"false\"></mbr-parameters>\n  <div class=\"go-wrap\">\n    <div class=\"go-info\" data-go-reveal>\n      <p class=\"go-kick\"><b>06</b><span mbr-text>צרו קשר</span></p>\n      <h2 class=\"go-title\" mbr-text>בואו נדבר<span>על הילד שלכם</span></h2>\n      <p class=\"go-lead\" mbr-text>לכל שאלה, פנייה או הרשמה, מוזמנים ליצור קשר או להשאיר פרטים ונחזור אליכם.</p>\n      <ul class=\"go-ways\">\n        <li><a href=\"tel:+972547733821\"><i><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2Z\"/></svg></i><span><b>טלפון</b><span dir=\"ltr\">054-773-3821</span></span></a></li>\n        <li><a href=\"https://wa.me/972547733821\" target=\"_blank\" rel=\"noopener\"><i><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"currentColor\"><path d=\"M12.04 2a9.9 9.9 0 0 0-8.5 15l-1.4 5 5.1-1.3A9.9 9.9 0 1 0 12.04 2Zm0 18.1a8.2 8.2 0 0 1-4.2-1.15l-.3-.18-3 .8.8-2.95-.2-.3a8.2 8.2 0 1 1 6.9 3.78Zm4.5-6.13c-.25-.12-1.46-.72-1.69-.8-.23-.08-.39-.12-.56.12-.16.25-.64.8-.78.97-.15.16-.29.18-.54.06a6.7 6.7 0 0 1-3.32-2.9c-.25-.43.25-.4.72-1.33.08-.16.04-.3-.02-.43l-.76-1.83c-.2-.48-.4-.41-.56-.42h-.47a.9.9 0 0 0-.66.31 2.76 2.76 0 0 0-.86 2.06 4.8 4.8 0 0 0 1 2.55 11 11 0 0 0 4.2 3.7c1.56.68 2.18.73 2.96.62.48-.07 1.46-.6 1.67-1.18.2-.58.2-1.07.15-1.18-.07-.1-.23-.16-.48-.29Z\"/></svg></i><span><b>וואטסאפ</b><span>שלחו הודעה למני</span></span></a></li>\n        <li><a href=\"mailto:Mani281279@gmail.com\"><i><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><path d=\"m3 7 9 6 9-6\"/></svg></i><span><b>אימייל</b><span>Mani281279@gmail.com</span></span></a></li>\n      </ul>\n    </div>\n    <div class=\"go-formcard\" data-go-reveal style=\"--d:.1s\">\n      <h2 class=\"go-ftitle\" mbr-text>תשאירו פרטים</h2>\n      <p class=\"go-fnote\" mbr-text>שדות עם * הם חובה.</p>\n      <div mbr-form>\n<!--Formbuilder Form-->\n<form action=\"Menire@sce.ac.il\" name=\"Mobirise Form\" method=\"POST\" class=\"mbr-form form-with-styler\" data-verified=\"Menire@sce.ac.il\">\n<div class=\"row\">\n<div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">הפרטים נשלחו בהצלחה! נחזור אליכם בהקדם.</div>\n<div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\">אופס, משהו השתבש. נסו שוב או שלחו לנו וואטסאפ.</div>\n</div>\n<div class=\"dragArea row\">\n<div class=\"col-md-6 form-group mb-3\" data-for=\"name\">\n<label for=\"name-contact\" class=\"form-control-label mbr-fonts-style\" mbr-theme-style=\"display-7\">שם מלא<span class=\"go-req\" aria-hidden=\"true\">*</span></label>\n<input type=\"text\" name=\"name\" id=\"name-contact\" autocomplete=\"name\" placeholder=\"שם מלא\" data-form-field=\"Name\" class=\"form-control\" mbr-theme-style=\"display-7\" required=\"required\" value>\n</div>\n<div class=\"col-md-6 form-group mb-3\" data-for=\"phone\">\n<label for=\"phone-contact\" class=\"form-control-label mbr-fonts-style\" mbr-theme-style=\"display-7\">טלפון<span class=\"go-req\" aria-hidden=\"true\">*</span></label>\n<input type=\"tel\" name=\"phone\" id=\"phone-contact\" autocomplete=\"tel\" placeholder=\"טלפון\" data-form-field=\"Phone\" class=\"form-control\" mbr-theme-style=\"display-7\" required=\"required\" value>\n</div>\n<div class=\"col-12 form-group mb-3\" data-for=\"email\">\n<label for=\"email-contact\" class=\"form-control-label mbr-fonts-style\" mbr-theme-style=\"display-7\">אימייל</label>\n<input type=\"email\" name=\"email\" id=\"email-contact\" autocomplete=\"email\" placeholder=\"אימייל\" data-form-field=\"Email\" class=\"form-control\" mbr-theme-style=\"display-7\" value>\n</div>\n<div class=\"col-12 form-group mb-3\" data-for=\"select\">\n<label for=\"select-contact\" class=\"form-control-label mbr-fonts-style\" mbr-theme-style=\"display-7\">במה אתם מתעניינים?</label>\n<select name=\"select\" id=\"select-contact\" data-form-field=\"select\" class=\"form-control form-select\" mbr-theme-style=\"display-7\"><option value=\"בית הספר לכדורגל\">בית הספר לכדורגל</option><option value=\"ימי הולדת כדורגל, ספורט\">ימי הולדת כדורגל, ספורט</option><option value=\"אימונים אישיים\">אימונים אישיים</option><option value=\"ימי גיבוש והפעלות ספורט\">ימי גיבוש והפעלות ספורט</option><option value=\"מחנה קיץ\">מחנה קיץ</option></select>\n</div>\n<div class=\"col-12 form-group mb-3\" data-for=\"message\">\n<label for=\"message-contact\" class=\"form-control-label mbr-fonts-style\" mbr-theme-style=\"display-7\">הודעה (לא חובה)</label>\n<textarea name=\"message\" id=\"message-contact\" placeholder=\"למשל: גיל הילד, תאריך מבוקש\" data-form-field=\"Message\" class=\"form-control\" mbr-theme-style=\"display-7\"></textarea>\n</div>\n<div class=\"col-12 input-group-btn\">\n<button type=\"submit\" class=\"btn go-submit\" mbr-theme-style=\"display-7\">שלחו ונחזור אליכם</button>\n</div>\n</div>\n</form><!--Formbuilder Form-->\n      </div>\n    </div>\n  </div>\n</section>",
          "_cid": "wZBsk6dRU2",
