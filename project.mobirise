                "gap": "26px"
              },
              ".go-fcol:last-child": {
                "grid-column": "1 / -1"
              },
              ".go-fbottom": {
                "flex-direction": "column",
                "text-align": "center"
              },
              ".go-fbtns .go-btn": {
                "flex": "1 1 100%"
              }
